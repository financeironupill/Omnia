<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Omnia - Gestão de Clientes</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2 text-warning"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="/dashboard" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar ao Dashboard</a>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-0"><i class="fa-solid fa-users text-primary me-2"></i>Gestão de Clientes</h3>
                    <p class="text-muted small mb-0">Consulta e manutenção da base de dados centralizada de clientes.</p>
                </div>
                <a href="/clientes/novo" class="btn btn-success fw-semibold shadow-sm"><i class="fa-solid fa-plus me-1"></i> Cadastrar Novo Cliente</a>
            </div>

            <hr class="text-muted">

            <!-- BARRA DE BUSCA -->
            <form action="/clientes" method="GET" class="mb-4">
                <div class="row g-2">
                    <div class="col-md-10">
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-search text-muted"></i></span>
                            <input type="text" name="busca" class="form-control" value="<%= buscaAtual %>" placeholder="Pesquisar por CPF/CNPJ, Razão Social ou Nome Fantasia...">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100 fw-semibold">Pesquisar</button>
                    </div>
                </div>
            </form>

            <!-- TABELA DE CLIENTES -->
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle bg-white mb-0 border">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 70px;">ID</th>
                            <th>Tipo</th>
                            <th>CPF / CNPJ</th>
                            <th>Nome / Fantasia</th>
                            <th>Gerente / Vendedor</th>
                            <th>Cidade / UF</th>
                            <th class="text-end" style="width: 160px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (clientes.length === 0) { %>
                            <tr><td colspan="7" class="text-center text-muted py-4">Nenhum cliente encontrado.</td></tr>
                        <% } else { %>
                            <% clientes.forEach(c => { %>
                                <tr>
                                    <td class="fw-bold text-secondary">#<%= c.id %></td>
                                    <td><span class="badge bg-secondary"><%= c.tipo_pessoa || 'PJ (CNPJ)' %></span></td>
                                    <td><span class="fw-semibold text-danger"><%= c.cnpj_cpf %></span></td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= c.nome %></div>
                                        <small class="text-muted"><%= c.nome_fantasia || '' %></small>
                                    </td>
                                    <td>
                                        <div><span class="badge" style="background-color: #6f42c1;">G: <%= c.gerente_nome || '--' %></span></div>
                                        <div><span class="badge bg-success">V: <%= c.vendedor_nome || '--' %></span></div>
                                    </td>
                                    <td><%= c.cidade %> / <%= c.uf %></td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a href="/clientes/editar/<%= c.id %>" class="btn btn-sm btn-outline-warning text-dark px-2"><i class="fa-solid fa-pen"></i> Editar</a>
                                            <form action="/clientes/excluir/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este cliente?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-2"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>