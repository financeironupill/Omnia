<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Detalhes da Cobrança #<%= conta.id %> - Omnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }</style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="/cobranca" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar à Cobrança</a>
        </div>
    </nav>

    <div class="container-fluid px-4" style="max-width: 1100px; margin-bottom: 50px;">
        
        <% if (locals.sucesso && sucesso) { %> <div class="alert alert-success py-2"><%= sucesso %></div> <% } %>
        <% if (locals.erro && erro) { %> <div class="alert alert-danger py-2"><%= erro %></div> <% } %>

        <!-- CARTÃO DE INFORMAÇÕES DA COBRANÇA -->
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold text-dark mb-0"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Cobrança #<%= conta.id %> - Doc: <%= conta.numero_documento %></h3>
                <div>
                    <span class="badge bg-secondary fs-6"><%= conta.status_boleto %></span>
                    <span class="badge bg-primary fs-6"><%= conta.status_cobranca || conta.tipo_cobranca %></span>
                </div>
            </div>
            <hr class="text-muted mb-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <small class="text-muted d-block">Cliente / Devedor</small>
                    <strong class="text-dark"><%= conta.cliente_nome %></strong>
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">Gerente / Vendedor</small>
                    <span><%= conta.gerente_nome || '--' %> / <%= conta.vendedor_nome || '--' %></span>
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">Valor Original</small>
                    <strong class="text-success">R$ <%= Number(conta.valor_original).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></strong>
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">Banco / Carteira</small>
                    <span><%= conta.banco || '--' %> (<%= conta.carteira || 'Simples' %>)</span>
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">Vencimento</small>
                    <span><%= conta.data_vencimento ? new Date(conta.data_vencimento).toLocaleDateString('pt-BR') : '--' %></span>
                </div>
            </div>
        </div>

        <!-- BOTÃO PARA ABRIR O MODAL DE REGISTO -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i>Histórico de Interações e Acordos</h4>
            <button class="btn btn-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#modalHistorico">
                <i class="fa-solid fa-plus me-1"></i> Registar Ação / Conversa
            </button>
        </div>

        <!-- LISTAGEM DO HISTÓRICO -->
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
            <% if (historico.length === 0) { %>
                <p class="text-muted text-center py-4 mb-0">Ainda não existem registos de interações para esta cobrança.</p>
            <% } else { %>
                <div class="timeline">
                    <% historico.forEach(h => { %>
                        <div class="border-start border-3 border-primary ps-3 mb-4">
                            <div class="d-flex justify-content-between">
                                <span class="badge bg-dark"><%= h.canal %> - <%= h.tipo_acao %></span>
                                <small class="text-muted"><i class="fa-regular fa-calendar me-1"></i><%= new Date(h.criado_em).toLocaleString('pt-BR') %></small>
                            </div>
                            <p class="mt-2 mb-1 text-dark"><%= h.descricao %></p>
                            <small class="text-muted fst-italic">Registado por: <%= h.usuario_nome || 'Sistema' %></small>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- MODAL PARA REGISTAR NOVA AÇÃO -->
    <div class="modal fade" id="modalHistorico" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/cobranca/historico/novo/<%= conta.id %>" method="POST">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title"><i class="fa-solid fa-headset me-2"></i>Registar Interação</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body g-3">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Canal de Comunicação</label>
                            <select name="canal" class="form-select" required>
                                <option value="E-mail">E-mail</option>
                                <option value="Telefone">Telefone (Ligação)</option>
                                <option value="Interno">Alinhamento Interno (Gerente/Vendedor)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tipo de Ação / Assunto</label>
                            <select name="tipo_acao" class="form-select" required>
                                <option value="E-mail 1 - Aviso de Vencimento">E-mail 1 - Aviso de Vencimento</option>
                                <option value="E-mail 2 - Risco de Cartório">E-mail 2 - Risco de Cartório</option>
                                <option value="E-mail 3 - Aviso Final (Próximo Dia Útil)">E-mail 3 - Aviso Final (Próximo Dia Útil)</option>
                                <option value="Ligação Realizada">Ligação Realizada</option>
                                <option value="Alinhamento com Gerente/Vendedor">Alinhamento com Gerente/Vendedor</option>
                                <option value="Outro Acordo/Observação">Outro Acordo / Observación</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descrição do que foi conversado / combinado</label>
                            <textarea name="descricao" class="form-control" rows="4" placeholder="Detalhes do que foi falado com o cliente, previsões dadas, etc..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Gravar Registo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>