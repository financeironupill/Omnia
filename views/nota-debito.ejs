<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Nota de Débito - <%= conta.numero_documento %> - Omnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { background-color: #fff; color: #000; font-family: 'Arial', sans-serif; font-size: 14px; }
        .container-nd { max-width: 800px; margin: 30px auto; padding: 30px; border: 1px solid #ddd; }
        .header-empresa { border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
        .bloco-assinatura { width: 320px; margin-top: 50px; text-align: center; }
        .assinatura-img { max-height: 140px; width: auto; display: block; margin: 0 auto -15px auto; }
        @media print {
            .btn-imprimir { display: none !important; }
            body { background: none; }
            .container-nd { border: none; padding: 0; margin: 0; max-width: 100%; }
        }
    </style>
</head>
<body>
    <div class="container container-nd">
        <!-- BOTÃO DE IMPRESSÃO RÁPIDA -->
        <div class="text-end mb-4 btn-imprimir">
            <button onclick="window.print()" class="btn btn-dark btn-sm"><i class="fa-solid fa-print me-1"></i> Imprimir / Salvar PDF</button>
            <a href="/cobranca/editar/<%= conta.id %>" class="btn btn-outline-secondary btn-sm ms-2">Voltar</a>
        </div>

        <!-- CABEÇALHO DA EMPRESA -->
        <div class="header-empresa text-center">
            <h5 class="fw-bold mb-1">CONDOR BRASIL INDUSTRIA E COMERCIO DE COSM. LTDA</h5>
            <p class="text-muted mb-0 small">CNPJ: 06.025.461/0001-03</p>
            <h4 class="fw-bold mt-3 text-uppercase" style="letter-spacing: 1px;">NOTA DE DÉBITO - <%= new Date().getFullYear() %>/<%= conta.numero_documento %></h4>
        </div>

        <div class="row mb-3 small">
            <div class="col-6">
                <strong>Data de Emissão:</strong> <%= new Date().toLocaleDateString('pt-BR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </div>
            <div class="col-6 text-end">
                <strong>Vencimento:</strong> <%= conta.data_vencimento ? new Date(conta.data_vencimento).toLocaleDateString('pt-BR') : 'A vista' %> <span class="text-danger">*(liberação de crédito somente após o pagamento)</span>
            </div>
        </div>

        <!-- 1. DADOS DO CLIENTE -->
        <div class="card mb-3 border-dark rounded-0">
            <div class="card-header bg-dark text-white py-1 small fw-bold">1. DADOS DO CLIENTE (DEVEDOR)</div>
            <div class="card-body py-2 small">
                <div class="mb-1"><strong>Razão Social:</strong> <%= conta.cliente_nome %> <%= conta.cliente_nome_fantasia ? '- ' + conta.cliente_nome_fantasia : '' %></div>
                <div><strong>CNPJ / CPF:</strong> <%= conta.cliente_cnpj || 'Não informado' %></div>
            </div>
        </div>

        <!-- 2. DISCRIMINAÇÃO DOS VALORES -->
        <div class="card mb-3 border-dark rounded-0">
            <div class="card-header bg-dark text-white py-1 small fw-bold">2. DISCRIMINAÇÃO DOS VALORES</div>
            <div class="card-body py-2 small">
                <p class="text-justify mb-3">
                    <%= conta.descricao_nota %>
                </p>
                <div class="row mb-2">
                    <div class="col-4"><strong>Documento de Origem:</strong> <%= conta.numero_documento %></div>
                    <div class="col-4"><strong>Vencimento Original:</strong> <%= conta.data_vencimento ? new Date(conta.data_vencimento).toLocaleDateString('pt-BR') : '-' %></div>
                    <div class="col-4 text-end"><strong>Valor do Título:</strong> R$ <%= conta.valor_original_fmt || conta.valor_original %></div>
                </div>

                <table class="table table-bordered border-dark mt-3 mb-0 small align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Descrição do Serviço / Encargo</th>
                            <th class="text-end" style="width: 180px;">Valor R$</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% conta.linhas_encargo.forEach(linha => { %>
                            <tr>
                                <td><%= linha.descricao %></td>
                                <td class="text-end fw-bold">R$ <%= linha.valor_fmt %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <td class="text-end fw-bold">Valor Total a Pagar:</td>
                            <td class="text-end fw-bold text-danger">R$ <%= conta.valor_total_nota_fmt %></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- 3. INSTRUÇÕES PARA PAGAMENTO -->
        <div class="card mb-4 border-dark rounded-0">
            <div class="card-header bg-dark text-white py-1 small fw-bold">3. INSTRUÇÕES PARA PAGAMENTO</div>
            <div class="card-body py-2 small">
                <p class="mb-2">O pagamento do valor supracitado deverá ser efetuado por meio de transferência, depósito ou PIX utilizando os dados bancários abaixo:</p>
                <div class="row g-1">
                    <div class="col-6"><strong>Banco:</strong> Bradesco</div>
                    <div class="col-6"><strong>Agência:</strong> 1262</div>
                    <div class="col-6"><strong>Conta Corrente:</strong> 21991-6</div>
                    <div class="col-6"><strong>Chave Pix (CNPJ):</strong> 06.025.461/0001-03</div>
                    <div class="col-12 mt-1"><strong>Favorecido:</strong> CONDOR BRASIL INDUSTRIA E COMERCIO DE COSM. LTDA</div>
                </div>
                <div class="mt-2 text-muted fst-italic">
                    Observação: A baixa somente será realizada após o envio do respectivo comprovante de pagamento para o e-mail: financeiro@nupill.com.br
                </div>
            </div>
        </div>

        <!-- ASSINATURA -->
        <div class="bloco-assinatura">
            <!-- Imagem da assinatura digitalizada com fundo transparente tratada -->
            <img src="/img/assinatura.png" alt="Assinatura" class="assinatura-img">
            <div style="border-top: 1px solid #000; padding-top: 4px;">
                <strong>Ednilson Pereira Gonçalves</strong><br>
                <span class="text-muted small">Gerente Financeiro</span>
            </div>
        </div>
    </div>
</body>
</html>