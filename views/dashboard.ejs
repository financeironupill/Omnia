<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - Omnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 800px;">
        <div class="card shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2>Portal Omnia</h2>
                    <p class="text-muted mb-0">Utilizador: <strong><%= usuario.nome %></strong> (<%= usuario.nivel %>)</p>
                </div>
                <a href="/logout" class="btn btn-outline-danger btn-sm">Terminar Sessão</a>
            </div>

            <hr>

            <h5 class="mb-3 text-secondary">MÓDULOS DO SISTEMA</h5>
            <div class="list-group mb-4">
                <a href="/solucao" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h6 class="mb-1 text-success fw-bold">Módulo Solução</h6>
                        <small class="text-muted">Gestão de Pós-Venda e Ocorrências</small>
                    </div>
                    <span class="badge bg-success rounded-pill">Aceder</span>
                </a>
            </div>

            <h5 class="mb-3 text-secondary">CADASTROS CENTRAIS</h5>
            <div class="list-group mb-4">
                <a href="/clientes" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h6 class="mb-1 text-primary fw-bold">Gestão de Clientes</h6>
                        <small class="text-muted">Base centralizada de clientes e dados bancários</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">Aceder</span>
                </a>
            </div>

            <% if (usuario.nivel === 'Administrador') { %>
                <h5 class="mb-3 text-secondary">ADMINISTRAÇÃO CENTRAL</h5>
                <div class="list-group">
                    <a href="/usuarios" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                        <div>
                            <h6 class="mb-1 text-dark fw-bold">Utilizadores e Acessos</h6>
                            <small class="text-muted">Gestão de contas e permissões do sistema</small>
                        </div>
                        <span class="badge bg-dark rounded-pill">Aceder</span>
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>