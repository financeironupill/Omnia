<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Portal Omnia - Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .navbar-brand { font-weight: 700; letter-spacing: 0.5px; }
        .card-modulo { transition: transform 0.2s, box-shadow 0.2s; border: none; border-left: 4px solid #0d6efd; }
        .card-modulo:hover { transform: translateY(-3px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08)!important; }
        .card-solucao { border-left-color: #198754; }
        .card-cobranca { border-left-color: #fd7e14; }
        .card-admin { border-left-color: #212529; }
        .card-clientes { border-left-color: #0d6efd; }
        .card-gerentes { border-left-color: #6f42c1; }
        .card-vendedores { border-left-color: #20c997; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/dashboard"><i class="fa-solid fa-cube me-2"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <div class="d-flex align-items-center">
                <span class="text-light me-3 small"><i class="fa-solid fa-user-circle me-1"></i> <%= usuario.nome %> (<%= usuario.nivel %>)</span>
                <a href="/logout" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-right-from-bracket me-1"></i> Terminar Sessão</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 py-4">
        <div class="row mb-4">
            <div class="col-12">
                <h3 class="fw-bold text-dark">Painel Principal</h3>
                <p class="text-muted">Selecione o módulo ou cadastro central pretendido para iniciar a operação.</p>
                <hr>
            </div>
        </div>

        <h5 class="mb-3 text-secondary text-uppercase fs-6 fw-bold">Módulos do Sistema</h5>
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card card-modulo card-solucao shadow-sm h-100 p-3 bg-white rounded-3">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-success text-white p-3 rounded-3 me-3"><i class="fa-solid fa-headset fa-lg"></i></div>
                                <h5 class="card-title fw-bold mb-0 text-success">Módulo Solução</h5>
                            </div>
                            <p class="card-text text-muted small">Gestão completa de pós-venda, ocorrências, transportadoras e financeiro associado.</p>
                        </div>
                        <a href="/solucao" class="btn btn-success mt-3 w-100 fw-semibold"><i class="fa-solid fa-arrow-right me-1"></i> Aceder ao Módulo</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card card-modulo card-cobranca shadow-sm h-100 p-3 bg-white rounded-3">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-warning text-dark p-3 rounded-3 me-3"><i class="fa-solid fa-file-invoice-dollar fa-lg"></i></div>
                                <h5 class="card-title fw-bold mb-0 text-dark">Omnia Cobrança</h5>
                            </div>
                            <p class="card-text text-muted small">Controlo de contas a receber, vencidas, múltiplos bancos e boletos antecipados.</p>
                        </div>
                        <a href="/cobranca" class="btn btn-warning text-dark mt-3 w-100 fw-semibold"><i class="fa-solid fa-arrow-right me-1"></i> Aceder à Cobrança</a>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="mb-3 text-secondary text-uppercase fs-6 fw-bold">Cadastros Centrais</h5>
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card card-modulo card-clientes shadow-sm h-100 p-3 bg-white rounded-3">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary text-white p-3 rounded-3 me-3"><i class="fa-solid fa-address-book fa-lg"></i></div>
                                <h5 class="card-title fw-bold mb-0 text-primary">Gestão de Clientes</h5>
                            </div>
                            <p class="card-text text-muted small">Base centralizada de clientes, moradas e informações bancárias/PIX.</p>
                        </div>
                        <a href="/clientes?origem=dashboard" class="btn btn-primary mt-3 w-100 fw-semibold"><i class="fa-solid fa-arrow-right me-1"></i> Aceder a Clientes</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-modulo card-gerentes shadow-sm h-100 p-3 bg-white rounded-3">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-purple text-white p-3 rounded-3 me-3" style="background-color: #6f42c1;"><i class="fa-solid fa-user-tie fa-lg"></i></div>
                                <h5 class="card-title fw-bold mb-0" style="color: #6f42c1;">Gestão de Gerentes</h5>
                            </div>
                            <p class="card-text text-muted small">Registo de gerentes com chave resumida, contactos e dados bancários/PIX.</p>
                        </div>
                        <a href="/gerentes" class="btn mt-3 w-100 fw-semibold text-white" style="background-color: #6f42c1;"><i class="fa-solid fa-arrow-right me-1"></i> Aceder a Gerentes</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-modulo card-vendedores shadow-sm h-100 p-3 bg-white rounded-3">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-teal text-white p-3 rounded-3 me-3" style="background-color: #20c997;"><i class="fa-solid fa-user-tag fa-lg"></i></div>
                                <h5 class="card-title fw-bold mb-0" style="color: #20c997;">Gestão de Vendedores</h5>
                            </div>
                            <p class="card-text text-muted small">Registo de vendedores vinculados a gerentes, com contactos e dados bancários/PIX.</p>
                        </div>
                        <a href="/vendedores" class="btn mt-3 w-100 fw-semibold text-white" style="background-color: #20c997;"><i class="fa-solid fa-arrow-right me-1"></i> Aceder a Vendedores</a>
                    </div>
                </div>
            </div>
        </div>

        <% if (usuario.nivel === 'Administrador') { %>
            <h5 class="mb-3 text-secondary text-uppercase fs-6 fw-bold">Administração Central</h5>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card card-modulo card-admin shadow-sm h-100 p-3 bg-white rounded-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-dark text-white p-3 rounded-3 me-3"><i class="fa-solid fa-users-gear fa-lg"></i></div>
                                    <h5 class="card-title fw-bold mb-0 text-dark">Utilizadores e Acessos</h5>
                                </div>
                                <p class="card-text text-muted small">Gestão de contas de operadores e níveis de permissão do sistema.</p>
                            </div>
                            <a href="/usuarios" class="btn btn-dark mt-3 w-100 fw-semibold"><i class="fa-solid fa-arrow-right me-1"></i> Gerir Utilizadores</a>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</body>
</html>