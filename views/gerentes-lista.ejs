<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Gestão de Gerentes - Omnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .table-hover tbody tr:hover { background-color: #f1f3f5; }
        .sort-link { color: #fff; text-decoration: none; display: flex; align-items: center; justify-content: space-between; }
        .sort-link:hover { color: #d1c4e9; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="/dashboard" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar ao Dashboard</a>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-0" style="color: #6f42c1!important;"><i class="fa-solid fa-user-tie me-2"></i>Gestão de Gerentes</h3>
                    <p class="text-muted small mb-0">Controlo de gerentes, chaves resumidas, contactos e dados bancários/PIX.</p>
                </div>
                <a href="/gerentes/novo" class="btn fw-semibold shadow-sm text-white" style="background-color: #6f42c1;"><i class="fa-solid fa-plus me-1"></i> Novo Gerente</a>
            </div>

            <hr class="text-muted">

            <% if (locals.sucesso && sucesso) { %> <div class="alert alert-success py-2"><%= sucesso %></div> <% } %>
            <% if (locals.erro && erro) { %> <div class="alert alert-danger py-2"><%= erro %></div> <% } %>

            <form method="GET" action="/gerentes" class="row g-2 mb-4">
                <input type="hidden" name="ordenar" value="<%= ordenarAtual %>">
                <input type="hidden" name="ordem" value="<%= ordemAtual %>">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-search text-muted"></i></span>
                        <input type="text" name="busca" class="form-control" placeholder="Pesquisar por Nome Resumido ou Nome Completo..." value="<%= buscaAtual %>">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn w-100 fw-semibold text-white" style="background-color: #6f42c1;">Pesquisar</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle bg-white mb-0 border">
                    <thead class="table-dark">
                        <tr>
                            <th class="py-3" style="width: 80px;">ID</th>
                            <th class="py-3">
                                <% 
                                    let novaOrdemResumido = (ordenarAtual === 'nome_resumido' && ordemAtual === 'ASC') ? 'DESC' : 'ASC';
                                %>
                                <a href="/gerentes?busca=<%= buscaAtual %>&ordenar=nome_resumido&ordem=<%= novaOrdemResumido %>" class="sort-link">
                                    <span>Nome Resumido (Chave)</span>
                                    <span>
                                        <% if (ordenarAtual === 'nome_resumido') { %>
                                            <i class="fa-solid fa-sort-<%= ordemAtual === 'ASC' ? 'up' : 'down' %> text-warning"></i>
                                        <% } else { %>
                                            <i class="fa-solid fa-sort text-muted opacity-50"></i>
                                        <% } %>
                                    </span>
                                </a>
                            </th>
                            <th class="py-3">
                                <% 
                                    let novaOrdemCompleto = (ordenarAtual === 'nome_completo' && ordemAtual === 'ASC') ? 'DESC' : 'ASC';
                                %>
                                <a href="/gerentes?busca=<%= buscaAtual %>&ordenar=nome_completo&ordem=<%= novaOrdemCompleto %>" class="sort-link">
                                    <span>Nome Completo</span>
                                    <span>
                                        <% if (ordenarAtual === 'nome_completo') { %>
                                            <i class="fa-solid fa-sort-<%= ordemAtual === 'ASC' ? 'up' : 'down' %> text-warning"></i>
                                        <% } else { %>
                                            <i class="fa-solid fa-sort text-muted opacity-50"></i>
                                        <% } %>
                                    </span>
                                </a>
                            </th>
                            <th class="py-3">Contacto</th>
                            <th class="py-3">PIX / Banco</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (gerentes.length === 0) { %>
                            <tr><td colspan="7" class="text-center text-muted py-4">Nenhum gerente encontrado.</td></tr>
                        <% } else { %>
                            <% gerentes.forEach(g => { %>
                                <tr>
                                    <td class="fw-bold text-secondary">#<%= g.id %></td>
                                    <td><span class="badge text-white px-2 py-1" style="background-color: #6f42c1; font-size: 0.9rem;"><%= g.nome_resumido %></span></td>
                                    <td class="fw-bold text-dark"><%= g.nome_completo %></td>
                                    <td>
                                        <div><i class="fa-solid fa-phone text-muted me-1 small"></i> <%= g.telefone || '--' %></div>
                                        <div><i class="fa-solid fa-envelope text-muted me-1 small"></i> <%= g.email || '--' %></div>
                                    </td>
                                    <td>
                                        <div><strong><%= g.banco || '--' %></strong></div>
                                        <small class="text-muted"><%= g.tipo_chave_pix ? g.tipo_chave_pix + ': ' : '' %><%= g.chave_pix || 'Sem PIX' %></small>
                                    </td>
                                    <td>
                                        <% if (g.ativo === 1) { %>
                                            <span class="badge bg-success">Ativo</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Inativo</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <a href="/gerentes/relatorio-vendedores/<%= g.id %>" class="btn btn-sm btn-outline-info text-dark px-2 me-1" title="Ver Vendedores"><i class="fa-solid fa-users"></i> Vendedores</a>
                                        <a href="/gerentes/editar/<%= g.id %>" class="btn btn-sm btn-outline-warning text-dark px-2 me-1" title="Editar"><i class="fa-solid fa-pen"></i> Editar</a>
                                        <form action="/gerentes/excluir/<%= g.id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-2" title="Excluir" onclick="return confirm('Tem certeza que deseja excluir este gerente?')"><i class="fa-solid fa-trash"></i> Excluir</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>