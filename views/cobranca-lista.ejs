<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Omnia Cobrança - Contas a Receber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .table-hover tbody tr:hover { background-color: #f1f3f5; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="/dashboard" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar ao Dashboard</a>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-0"><i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i>Omnia Cobrança</h3>
                    <p class="text-muted small mb-0">Controlo avançado de contas a receber, status de boletos, custas e carteiras.</p>
                </div>
                <a href="/cobranca/nova" class="btn btn-warning fw-semibold shadow-sm text-dark"><i class="fa-solid fa-plus me-1"></i> Nova Cobrança</a>
            </div>

            <hr class="text-muted">

            <% if (locals.sucesso && sucesso) { %> <div class="alert alert-success py-2"><%= sucesso %></div> <% } %>
            <% if (locals.erro && erro) { %> <div class="alert alert-danger py-2"><%= erro %></div> <% } %>

            <form method="GET" action="/cobranca" class="row g-2 mb-4">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-search text-muted"></i></span>
                        <input type="text" name="busca" class="form-control" placeholder="Pesquisar Documento, Cliente..." value="<%= buscaAtual %>">
                    </div>
                </div>
                <div class="col-md-2">
                    <select name="status" class="form-select">
                        <option value="TODOS_MENOS_PAGO" <%= statusAtual === 'TODOS_MENOS_PAGO' ? 'selected' : '' %>>Em Aberto (Exceto Pagos)</option>
                        <option value="">Todos os Status</option>
                        <option value="Vencido" <%= statusAtual === 'Vencido' ? 'selected' : '' %>>Vencido</option>
                        <option value="Pago" <%= statusAtual === 'Pago' ? 'selected' : '' %>>Pago</option>
                        <option value="Pago com Pendência" <%= statusAtual === 'Pago com Pendência' ? 'selected' : '' %>>Pago com Pendência</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="gerente_id" class="form-select">
                        <option value="">Todos Gerentes</option>
                        <% gerentes.forEach(g => { %>
                            <option value="<%= g.id %>" <%= gerenteAtual == g.id ? 'selected' : '' %>><%= g.nome_resumido %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="vendedor_id" class="form-select">
                        <option value="">Todos Vendedores</option>
                        <% vendedores.forEach(v => { %>
                            <option value="<%= v.id %>" <%= vendedorAtual == v.id ? 'selected' : '' %>><%= v.nome_resumido %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">Filtrar</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle bg-white mb-0 border">
                    <thead class="table-dark">
                        <tr>
                            <th class="py-3">ID</th>
                            <th class="py-3">Documento</th>
                            <th class="py-3">Cliente</th>
                            <th class="py-3">Gerente / Vendedor</th>
                            <th class="py-3">Banco / Cart.</th>
                            <th class="py-3">Vencimento</th>
                            <th class="py-3">Dias Venc.</th>
                            <th class="py-3">Valor</th>
                            <th class="py-3">Boleto / Cobrança</th>
                            <th class="py-3 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (contas.length === 0) { %>
                            <tr><td colspan="10" class="text-center text-muted py-4">Nenhum registo de cobrança encontrado.</td></tr>
                        <% } else { %>
                            <% contas.forEach(c => { %>
                                <tr>
                                    <td class="fw-bold text-secondary">#<%= c.id %></td>
                                    <td><%= c.numero_documento %></td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= c.cliente_nome || 'Cliente não associado' %></div>
                                        <% if (c.cliente_cnpj) { %><small class="text-muted"><%= c.cliente_cnpj %></small><% } %>
                                    </td>
                                    <td>
                                        <div><span class="badge" style="background-color: #6f42c1;"><%= c.gerente_nome || '--' %></span></div>
                                        <small class="text-muted"><%= c.vendedor_nome || '--' %></small>
                                    </td>
                                    <td>
                                        <div><strong><%= c.banco %></strong></div>
                                        <small class="text-muted"><%= c.carteira %></small>
                                    </td>
                                    <td><%= c.data_vencimento ? new Date(c.data_vencimento).toLocaleDateString('pt-BR') : '--' %></td>
                                    <td><span class="badge bg-danger"><%= c.dias_vencidos_calc %> dias</span></td>
                                    <td class="fw-bold text-success">R$ <%= Number(c.valor_original).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                                    <td>
                                        <div><span class="badge bg-secondary"><%= c.status_boleto %></span></div>
                                        <small class="text-muted"><%= c.status_cobranca || c.tipo_cobranca %></small>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a href="/cobranca/detalhes/<%= c.id %>" class="btn btn-sm btn-outline-primary px-2" title="Ver Detalhes e Histórico"><i class="fa-solid fa-eye"></i> Detalhes</a>
                                            <a href="/cobranca/editar/<%= c.id %>" class="btn btn-sm btn-outline-warning text-dark px-2" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                            <form action="/cobranca/excluir/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir a cobrança #<%= c.id %> e todo o seu histórico?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-2" title="Excluir"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>