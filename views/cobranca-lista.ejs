<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Omnia - Módulo de Cobrança (Boletos)</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">

    <!-- NAVBAR DA APLICAÇÃO -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold" href="/dashboard">
                <i class="fa-solid fa-layer-group text-primary me-2"></i>OMNIA
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard"><i class="fa-solid fa-chart-line me-1"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/cobranca"><i class="fa-solid fa-file-invoice-dollar me-1"></i> Cobrança</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/ocorrencias"><i class="fa-solid fa-triangle-exclamation me-1"></i> Ocorrências</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/clientes"><i class="fa-solid fa-users me-1"></i> Clientes</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <a href="/logout" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-right-from-bracket me-1"></i> Sair</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- CONTEÚDO PRINCIPAL -->
    <div class="container-fluid px-4 py-2">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
            
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-1">
                        <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Gestão de Cobrança (Boletos)
                    </h3>
                    <p class="text-muted small mb-0">Consulte, filtre e gira os boletos registados no sistema.</p>
                </div>
                <a href="/cobranca/nova" class="btn btn-primary fw-semibold px-3">
                    <i class="fa-solid fa-plus me-1"></i> Cadastrar Boleto
                </a>
            </div>

            <% if (locals.erro && erro) { %> <div class="alert alert-danger py-2"><%= erro %></div> <% } %>
            <% if (locals.sucesso && sucesso) { %> <div class="alert alert-success py-2"><%= sucesso %></div> <% } %>

            <!-- FILTROS DE PESQUISA -->
            <form action="/cobranca" method="GET" class="row g-2 mb-4 bg-light p-3 rounded border">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Pesquisa Geral</label>
                    <input type="text" name="busca" class="form-control form-control-sm" placeholder="Nº Documento, Cliente ou Banco..." value="<%= buscaAtual %>">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Situação</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">Todas</option>
                        <option value="Vencido" <%= statusAtual === 'Vencido' ? 'selected' : '' %>>Vencido</option>
                        <option value="Aguardando Custas" <%= statusAtual === 'Aguardando Custas' ? 'selected' : '' %>>Aguardando Custas</option>
                        <option value="Liquidado" <%= statusAtual === 'Liquidado' ? 'selected' : '' %>>Liquidado</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Gerente</label>
                    <select name="gerente_id" id="filtroGerente" class="form-select form-select-sm">
                        <option value="">Todos os Gerentes</option>
                        <% gerentes.forEach(g => { %>
                            <option value="<%= g.id %>" <%= gerenteAtual == g.id ? 'selected' : '' %>><%= g.nome_resumido %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Vendedor</label>
                    <select name="vendedor_id" id="filtroVendedor" class="form-select form-select-sm">
                        <option value="">Todos os Vendedores</option>
                        <% vendedores.forEach(v => { %>
                            <option value="<%= v.id %>" data-gerente-id="<%= v.gerente_id %>" <%= vendedorAtual == v.id ? 'selected' : '' %>><%= v.nome_resumido %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-secondary btn-sm w-100 fw-semibold"><i class="fa-solid fa-filter me-1"></i> Filtrar</button>
                    <a href="/cobranca" class="btn btn-outline-secondary btn-sm fw-semibold"><i class="fa-solid fa-rotate-left"></i></a>
                </div>
            </form>

            <!-- TABELA DE BOLETOS -->
            <div class="table-responsive">
                <table class="table table-hover align-middle border">
                    <thead class="table-dark">
                        <tr>
                            <th>Nº Documento</th>
                            <th>Cliente</th>
                            <th>Banco</th>
                            <th>Carteira</th>
                            <th>Vencimento</th>
                            <th class="text-end">Valor Original</th>
                            <th class="text-center">Situação</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (contas && contas.length > 0) { %>
                            <% contas.forEach(b => { %>
                                <tr>
                                    <td class="fw-bold"><%= b.numero_documento %></td>
                                    <td>
                                        <div class="fw-semibold"><%= b.cliente_nome || 'N/A' %></div>
                                        <small class="text-muted"><%= b.cliente_cnpj || '' %></small>
                                    </td>
                                    <td><%= b.banco || '-' %></td>
                                    <td><span class="badge bg-secondary"><%= b.carteira %></span></td>
                                    <td><%= b.data_vencimento ? new Date(b.data_vencimento).toLocaleDateString('pt-BR') : '-' %></td>
                                    <td class="text-end fw-bold">R$ <%= b.valor_original_fmt %></td>
                                    <td class="text-center">
                                        <% if (b.situacao_boleto === 'Liquidado') { %>
                                            <span class="badge bg-success">Liquidado</span>
                                        <% } else if (b.situacao_boleto === 'Aguardando Custas') { %>
                                            <span class="badge bg-warning text-dark">Aguardando Custas</span>
                                        <% } else { %>
                                            <span class="badge bg-danger">Vencido</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <a href="/cobranca/editar/<%= b.id %>" class="btn btn-outline-primary btn-sm me-1" title="Editar">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Nenhum boleto encontrado.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- Bootstrap JS e Script de Filtro Encadeado Gerente -> Vendedor -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filtroGerente = document.getElementById('filtroGerente');
            const filtroVendedor = document.getElementById('filtroVendedor');

            function filtrarVendedores() {
                const gerenteSel = filtroGerente.value;
                Array.from(filtroVendedor.options).forEach(opt => {
                    if (!opt.value) return; // Opção "Todos os Vendedores"
                    const gId = opt.getAttribute('data-gerente-id');
                    if (!gerenteSel || gId === gerenteSel) {
                        opt.style.display = '';
                    } else {
                        opt.style.display = 'none';
                        if (opt.selected) filtroVendedor.value = '';
                    }
                });
            }

            filtroGerente.addEventListener('change', filtrarVendedores);
            filtrarVendedores();
        });
    </script>
</body>
</html>