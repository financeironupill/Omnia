<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Omnia - <%= transportadora ? 'Editar' : 'Nova' %> Transportadora</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2 text-warning"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="/transportadoras" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar às Transportadoras</a>
        </div>
    </nav>

    <div class="container py-4">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white max-width-800 mx-auto">
            <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-truck-fast text-warning me-2"></i><%= transportadora ? 'Editar' : 'Cadastrar' %> Transportadora</h3>
            <p class="text-muted small mb-4">Insira os dados da empresa de transporte parceira.</p>

            <form action="/transportadoras/<%= transportadora && transportadora.id ? 'editar/' + transportadora.id : 'novo' %>" method="POST">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">CNPJ *</label>
                        <input type="text" name="cnpj" id="inputCnpj" class="form-control" value="<%= transportadora ? transportadora.cnpj : '' %>" placeholder="00.000.000/0000-00" required>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label small fw-bold">Razão Social / Nome *</label>
                        <input type="text" name="nome" class="form-control" value="<%= transportadora ? transportadora.nome : '' %>" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Nome Fantasia</label>
                        <input type="text" name="nome_fantasia" class="form-control" value="<%= transportadora ? transportadora.nome_fantasia : '' %>">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Pessoa de Contacto</label>
                        <input type="text" name="contato" class="form-control" value="<%= transportadora ? transportadora.contato : '' %>">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">E-mail</label>
                        <input type="email" name="email" class="form-control" value="<%= transportadora ? transportadora.email : '' %>">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Telefone</label>
                        <input type="text" name="telefone" class="form-control" value="<%= transportadora ? transportadora.telefone : '' %>">
                    </div>

                    <div class="col-md-8">
                        <label class="form-label small fw-bold">Cidade</label>
                        <input type="text" name="cidade" class="form-control" value="<%= transportadora ? transportadora.cidade : '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">UF</label>
                        <input type="text" name="uf" class="form-control text-uppercase" maxlength="2" value="<%= transportadora ? transportadora.uf : '' %>">
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="/transportadoras" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success fw-semibold px-4"><i class="fa-solid fa-save me-1"></i> Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const inputCnpj = document.getElementById('inputCnpj');
            function aplicarMascara(v) {
                v = v.replace(/\D/g, '');
                return v.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5').slice(0, 18);
            }
            inputCnpj.addEventListener('input', function(e) {
                e.target.value = aplicarMascara(e.target.value);
            });
            if (inputCnpj.value) {
                inputCnpj.value = aplicarMascara(inputCnpj.value);
            }
        });
    </script>
</body>
</html>