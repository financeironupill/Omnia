<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Registar/Editar Utilizador - Omnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container mt-4" style="max-width: 600px;">
        <h2><%= usuario ? 'Editar Utilizador' : 'Novo Utilizador' %></h2>
        <a href="/usuarios" class="btn btn-secondary mb-3">Voltar</a>
        <form action="<%= usuario ? '/usuarios/editar/' + usuario.id : '/usuarios/novo' %>" method="POST" class="bg-white p-4 shadow-sm rounded">
            <div class="mb-3">
                <label class="form-label">Nome Completo</label>
                <input type="text" name="nome" class="form-control" value="<%= usuario ? usuario.nome : '' %>" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Nome de Utilizador (Login)</label>
                <input type="text" name="usuario" class="form-control" value="<%= usuario ? usuario.usuario : '' %>" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Palavra-passe <%= usuario ? '(Deixe em branco para manter a atual)' : '' %></label>
                <input type="password" name="senha" class="form-control" <%= usuario ? '' : 'required' %>>
            </div>
            <div class="mb-3">
                <label class="form-label">Nível de Acesso</label>
                <select name="nivel" class="form-control" required>
                    <option value="Básico" <%= usuario && usuario.nivel === 'Básico' ? 'selected' : '' %>>Básico</option>
                    <option value="Moderado" <%= usuario && usuario.nivel === 'Moderado' ? 'selected' : '' %>>Moderado</option>
                    <option value="Administrador" <%= usuario && usuario.nivel === 'Administrador' ? 'selected' : '' %>>Administrador</option>
                </select>
            </div>
            <button type="submit" class="btn btn-success">Guardar</button>
        </form>
    </div>
</body>
</html>