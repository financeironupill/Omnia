<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Gestão de Clientes - Omnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .table-hover tbody tr:hover { background-color: #f1f3f5; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="<%= origemAtual === 'solucao' ? '/solucao' : '/dashboard' %>" class="btn btn-outline-light btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Voltar ao <%= origemAtual === 'solucao' ? 'Módulo Solução' : 'Dashboard' %>
            </a>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-0"><i class="fa-solid fa-address-book text-primary me-2"></i>Gestão de Clientes</h3>
                    <p class="text-muted small mb-0">Consulta e manutenção da base de dados centralizada de clientes.</p>
                </div>
                <a href="/clientes/novo" class="btn btn-success fw-semibold shadow-sm"><i class="fa-solid fa-plus me-1"></i> Cadastrar Novo Cliente</a>
            </div>

            <hr class="text-muted">

            <% if (locals.sucesso && sucesso) { %> <div class="alert alert-success py-2"><%= sucesso %></div> <% } %>
            <% if (locals.erro && erro) { %> <div class="alert alert-danger py-2"><%= erro %></div> <% } %>

            <form method="GET" action="/clientes" class="row g-2 mb-4">
                <input type="hidden" name="origem" value="<%= origemAtual %>">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-search text-muted"></i></span>
                        <input type="text" name="busca" class="form-control" placeholder="Pesquisar por CPF/CNPJ, Razão Social ou Nome Fantasia..." value="<%= buscaAtual %>">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">Pesquisar</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle bg-white mb-0 border">
                    <thead class="table-dark">
                        <tr>
                            <th class="py-3">ID</th>
                            <th class="py-3">Tipo</th>
                            <th class="py-3">CPF / CNPJ</th>
                            <th class="py-3">Nome / Fantasia</th>
                            <th class="py-3">Gerente / Vendedor</th>
                            <th class="py-3">Cidade/UF</th>
                            <th class="py-3 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (clientes.length === 0) { %>
                            <tr><td colspan="7" class="text-center text-muted py-4">Nenhum cliente encontrado.</td></tr>
                        <% } else { %>
                            <% clientes.forEach(c => { %>
                                <tr>
                                    <td class="fw-bold text-secondary">#<%= c.id %></td>
                                    <td><span class="badge bg-secondary"><%= c.tipo_pessoa %></span></td>
                                    <td><%= c.cnpj_cpf %></td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= c.nome %></div>
                                        <% if (c.nome_fantasia) { %><small class="text-muted"><%= c.nome_fantasia %></small><% } %>
                                    </td>
                                    <td>
                                        <div><span class="badge" style="background-color: #6f42c1;">G: <%= c.gerente_nome || '--' %></span></div>
                                        <div class="mt-1"><span class="badge" style="background-color: #20c997;">V: <%= c.vendedor_nome || '--' %></span></div>
                                    </td>
                                    <td><%= c.cidade %> / <%= c.uf %></td>
                                    <td class="text-end">
                                        <a href="/clientes/editar/<%= c.id %>" class="btn btn-sm btn-outline-warning text-dark px-2 me-1" title="Editar"><i class="fa-solid fa-pen"></i> Editar</a>
                                        <form action="/clientes/excluir/<%= c.id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-2" title="Excluir" onclick="return confirm('Tem certeza que deseja excluir este cliente?')"><i class="fa-solid fa-trash"></i> Excluir</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>