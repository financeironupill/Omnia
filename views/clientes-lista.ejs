<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Gestão de Clientes - Omnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container mt-3" style="max-width: 1000px;">
        <div class="card shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h4 class="mb-0">Gestão de Clientes</h4>
                    <a href="<%= origemAtual === 'solucao' ? '/solucao' : '/dashboard' %>" class="text-decoration-none text-primary small">← Voltar ao <%= origemAtual === 'solucao' ? 'Módulo Solução' : 'Dashboard' %></a>
                </div>
                <a href="/clientes/novo" class="btn btn-success btn-sm">+ Cadastrar Novo Cliente</a>
            </div>

            <% if (locals.sucesso && sucesso) { %> <div class="alert alert-success py-1 mb-2 small"><%= sucesso %></div> <% } %>
            <% if (locals.erro && erro) { %> <div class="alert alert-danger py-1 mb-2 small"><%= erro %></div> <% } %>

            <form method="GET" action="/clientes" class="row g-2 mb-3">
                <input type="hidden" name="origem" value="<%= origemAtual %>">
                <div class="col-md-10">
                    <input type="text" name="busca" class="form-control form-control-sm" placeholder="Pesquisar por CPF/CNPJ, Razão Social ou Nome Fantasia..." value="<%= buscaAtual %>">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Buscar</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle bg-white mb-0" style="font-size: 0.9rem;">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tipo</th>
                            <th>CPF / CNPJ</th>
                            <th>Nome / Fantasia</th>
                            <th>Cidade/UF</th>
                            <th>PIX</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (clientes.length === 0) { %>
                            <tr><td colspan="7" class="text-center text-muted py-3">Nenhum cliente encontrado.</td></tr>
                        <% } else { %>
                            <% clientes.forEach(c => { %>
                                <tr>
                                    <td><%= c.id %></td>
                                    <td><%= c.tipo_pessoa %></td>
                                    <td><%= c.cnpj_cpf %></td>
                                    <td>
                                        <strong><%= c.nome %></strong>
                                        <% if (c.nome_fantasia) { %><br><small class="text-muted"><%= c.nome_fantasia %></small><% } %>
                                    </td>
                                    <td><%= c.cidade %> / <%= c.uf %></td>
                                    <td><%= c.chave_pix || '--' %></td>
                                    <td class="text-end">
                                        <a href="/clientes/editar/<%= c.id %>" class="btn btn-sm btn-warning py-0 px-1" style="font-size: 0.8rem;">Editar</a>
                                        <form action="/clientes/excluir/<%= c.id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger py-0 px-1" style="font-size: 0.8rem;" onclick="return confirm('Tem certeza?')">Excluir</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>