    <!-- SCRIPTS DA APLICAÇÃO -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let emailAvisoPreparadoUrl = '';
        let emailReguaEtapaPendente = null;
        let emailLiquidacaoPendente = false;

        const dadosBoleto = {
            id: "<%= conta ? conta.id : '' %>",
            numero_documento: "<%= conta ? conta.numero_documento : '' %>",
            valor_original: "<%= conta ? conta.valor_original : '0,00' %>",
            valor_custas: "<%= conta ? conta.valor_custas : '0,00' %>",
            data_vencimento: "<%= conta && conta.data_vencimento ? new Date(conta.data_vencimento).toLocaleDateString('pt-BR') : '' %>",
            situacao_boleto: "<%= conta ? conta.situacao_boleto : '' %>",
            cliente_nome: "<%= conta ? conta.cliente_nome : '' %>",
            cliente_nome_fantasia: "<%= conta ? conta.cliente_nome_fantasia || '' : '' %>",
            cliente_email: "<%= conta ? conta.cliente_email : '' %>",
            gerente_email: "<%= conta && conta.gerente_email ? conta.gerente_email : '' %>",
            vendedor_email: "<%= conta && conta.vendedor_email ? conta.vendedor_email : '' %>"
        };

        async function prepararEmailAviso1() {
            return prepararEmailRégua(1);
        }

        function abrirEmailPreparado() {
            if (emailAvisoPreparadoUrl) {
                window.open(emailAvisoPreparadoUrl, '_blank');
            }
        }

        function dispararEmail(para, cc, assunto, corpo) {
            emailAvisoPreparadoUrl = `mailto:${encodeURIComponent(para)}?cc=${encodeURIComponent(cc)}&subject=${encodeURIComponent(assunto)}&body=${encodeURIComponent(corpo)}`;
            window.location.href = emailAvisoPreparadoUrl;
            emailReguaEtapaPendente = null;
            emailLiquidacaoPendente = false;
            document.getElementById('btnConfirmarEnvio').hidden = true;
            document.getElementById('emailConfirmFeedback').className = 'alert d-none';

            document.getElementById('emailParaModal').value = para;
            document.getElementById('emailCcModal').value = cc;
            document.getElementById('emailAssuntoModal').value = assunto;
            document.getElementById('emailTextoModal').value = corpo;

            setTimeout(() => {
                const modalCopiar = new bootstrap.Modal(document.getElementById('modalCopiarEmail'));
                modalCopiar.show();
            }, 1000);
        }

        function copiarTextoEmail() {
            const txt = document.getElementById('emailTextoModal');
            txt.select();
            document.execCommand('copy');
            alert('Texto copiado com sucesso para a área de transferência!');
        }

        async function prepararEmailRégua(etapa) {
            const feedback = document.getElementById('emailAvisoFeedback');
            const botaoConfirmar = document.getElementById('btnConfirmarEnvio');
            let janelaEmail = null;
            emailLiquidacaoPendente = false;
            feedback.className = 'alert d-none mt-3 mb-0';
            try {
                janelaEmail = window.open('about:blank', '_blank');
                const resposta = await fetch(`/cobranca/email-regua/preparar/${encodeURIComponent(dadosBoleto.id)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify({ etapa })
                });
                const resultado = await resposta.json();
                if (!resposta.ok) throw new Error(resultado.erro || 'Não foi possível preparar o e-mail.');

                const cc = Array.isArray(resultado.cc) ? resultado.cc : [];
                document.getElementById('emailParaModal').value = resultado.para;
                document.getElementById('emailCcModal').value = cc.join(',');
                document.getElementById('emailAssuntoModal').value = resultado.assunto;
                document.getElementById('emailTextoModal').value = resultado.corpo;
                emailAvisoPreparadoUrl = `mailto:${encodeURIComponent(resultado.para)}?cc=${encodeURIComponent(cc.join(','))}&subject=${encodeURIComponent(resultado.assunto)}&body=${encodeURIComponent(resultado.corpo)}`;
                emailReguaEtapaPendente = etapa;
                botaoConfirmar.hidden = false;
                botaoConfirmar.disabled = false;

                if (janelaEmail && !janelaEmail.closed) {
                    janelaEmail.location.href = emailAvisoPreparadoUrl;
                    feedback.textContent = 'E-mail preparado no cliente de e-mail. Após enviá-lo, clique em “Confirmar Envio” para registrar a interação e atualizar a fase.';
                    feedback.className = 'alert alert-info mt-3 mb-0';
                } else {
                    feedback.textContent = 'E-mail preparado. O navegador bloqueou a nova janela; use “Abrir cliente de e-mail”. Após enviar, clique em “Confirmar Envio”.';
                    feedback.className = 'alert alert-warning mt-3 mb-0';
                }
                const modalFeedback = document.getElementById('emailConfirmFeedback');
                modalFeedback.textContent = 'A interação só será gravada e a fase atualizada após confirmar que o e-mail foi enviado.';
                modalFeedback.className = 'alert alert-info';
                new bootstrap.Modal(document.getElementById('modalCopiarEmail')).show();
            } catch (err) {
                if (janelaEmail && !janelaEmail.closed) janelaEmail.close();
                feedback.textContent = err.message;
                feedback.className = 'alert alert-danger mt-3 mb-0';
            }
        }

        async function confirmarEnvioEmail() {
            const botao = document.getElementById('btnConfirmarEnvio');
            const modalFeedback = document.getElementById('emailConfirmFeedback');
            if (!emailReguaEtapaPendente && !emailLiquidacaoPendente) return;

            botao.disabled = true;
            try {
                const liquidacao = emailLiquidacaoPendente;
                const rota = liquidacao ? 'email-liquidacao' : 'email-regua';
                const corpo = liquidacao
                    ? {
                        para: document.getElementById('emailParaModal').value,
                        assunto: document.getElementById('emailAssuntoModal').value,
                        corpo: document.getElementById('emailTextoModal').value
                    }
                    : {
                        etapa: emailReguaEtapaPendente,
                        para: document.getElementById('emailParaModal').value,
                        cc: document.getElementById('emailCcModal').value,
                        assunto: document.getElementById('emailAssuntoModal').value,
                        corpo: document.getElementById('emailTextoModal').value
                    };
                const resposta = await fetch(`/cobranca/${rota}/confirmar/${encodeURIComponent(dadosBoleto.id)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify(corpo)
                });
                const resultado = await resposta.json();
                if (!resposta.ok) throw new Error(resultado.erro || 'Não foi possível confirmar o envio.');

                const faseSelect = document.querySelector('#formBoleto select[name="status_cobranca"]');
                if (faseSelect && resultado.fase) faseSelect.value = resultado.fase;
                document.getElementById('emailAvisoFeedback').textContent = resultado.sucesso;
                document.getElementById('emailAvisoFeedback').className = 'alert alert-success mt-3 mb-0';
                modalFeedback.textContent = resultado.sucesso;
                modalFeedback.className = 'alert alert-success';
                emailReguaEtapaPendente = null;
                emailLiquidacaoPendente = false;
                botao.hidden = true;
                window.setTimeout(() => window.location.reload(), 900);
            } catch (err) {
                modalFeedback.textContent = err.message;
                modalFeedback.className = 'alert alert-danger';
                botao.disabled = false;
            }
        }

        function preencherEdicaoInteracao(botao) {
            const form = document.getElementById('formEditarInteracao');
            form.action = `/cobranca/historico/editar/${encodeURIComponent(botao.dataset.boletoId)}/${encodeURIComponent(botao.dataset.historicoId)}`;
            const tipoContato = document.getElementById('editarTipoContato');
            const tipoSalvo = botao.dataset.tipoContato;
            if (![...tipoContato.options].some(option => option.value === tipoSalvo)) {
                tipoContato.add(new Option(tipoSalvo, tipoSalvo));
            }
            tipoContato.value = tipoSalvo;
            document.getElementById('editarCanal').value = botao.dataset.canal;
            document.getElementById('editarContatoNome').value = botao.dataset.contatoNome;
            document.getElementById('editarResumo').value = botao.dataset.resumo;
        }

        async function prepararEmailAvisoComercial() {
            const feedback = document.getElementById('emailAvisoFeedback');
            const botaoConfirmar = document.getElementById('btnConfirmarEnvio');
            let janelaEmail = null;
            feedback.className = 'alert d-none mt-3 mb-0';

            try {
                janelaEmail = window.open('about:blank', '_blank');
                const resposta = await fetch(`/cobranca/email-liquidacao/preparar/${encodeURIComponent(dadosBoleto.id)}`, {
                    method: 'POST',
                    headers: { Accept: 'application/json' }
                });
                const resultado = await resposta.json();
                if (!resposta.ok) throw new Error(resultado.erro || 'Não foi possível preparar o aviso de liquidação.');

                document.getElementById('emailParaModal').value = resultado.para;
                document.getElementById('emailCcModal').value = '';
                document.getElementById('emailAssuntoModal').value = resultado.assunto;
                document.getElementById('emailTextoModal').value = resultado.corpo;
                emailAvisoPreparadoUrl = `mailto:${encodeURIComponent(resultado.para)}?subject=${encodeURIComponent(resultado.assunto)}&body=${encodeURIComponent(resultado.corpo)}`;
                emailReguaEtapaPendente = null;
                emailLiquidacaoPendente = true;
                botaoConfirmar.hidden = false;
                botaoConfirmar.disabled = false;

                if (janelaEmail && !janelaEmail.closed) {
                    janelaEmail.location.href = emailAvisoPreparadoUrl;
                    feedback.textContent = 'E-mail preparado no cliente de e-mail. Após enviá-lo, confirme o envio para registrar a interação no histórico.';
                    feedback.className = 'alert alert-info mt-3 mb-0';
                } else {
                    feedback.textContent = 'E-mail preparado. O navegador bloqueou a nova janela; use “Abrir cliente de e-mail”. Após enviar, confirme o envio.';
                    feedback.className = 'alert alert-warning mt-3 mb-0';
                }

                const modalFeedback = document.getElementById('emailConfirmFeedback');
                modalFeedback.textContent = 'A interação será gravada no histórico após confirmar que o e-mail foi enviado.';
                modalFeedback.className = 'alert alert-info';
                new bootstrap.Modal(document.getElementById('modalCopiarEmail')).show();
            } catch (err) {
                if (janelaEmail && !janelaEmail.closed) janelaEmail.close();
                feedback.textContent = err.message;
                feedback.className = 'alert alert-danger mt-3 mb-0';
            }
        }

        async function prepararEmailRetornado() {
            const destinatarios = [dadosBoleto.gerente_email, dadosBoleto.vendedor_email].filter(Boolean).join(',');
            const emailAtual = dadosBoleto.cliente_email || 'Não informado';
            
            if (!destinatarios) {
                alert('O gerente e/ou vendedor deste cliente não possuem e-mail cadastrado.');
                return;
            }

            try {
                const resposta = await fetch(`/cobranca/email-falha/${encodeURIComponent(dadosBoleto.id)}`, {
                    method: 'POST',
                    headers: { Accept: 'application/json' }
                });
                const resultado = await resposta.json();
                if (!resposta.ok) {
                    throw new Error(resultado.erro || 'Erro ao registrar a falha no histórico.');
                }

                dispararEmail(resultado.para, '', resultado.assunto, resultado.corpo);
                const feedback = document.getElementById('emailAvisoFeedback');
                feedback.textContent = resultado.sucesso + ' Atualizando a página...';
                feedback.className = 'alert alert-success mt-3 mb-0';

                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } catch (err) {
                const feedback = document.getElementById('emailAvisoFeedback');
                feedback.textContent = err.message || 'Erro ao registrar a falha no histórico.';
                feedback.className = 'alert alert-danger mt-3 mb-0';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const modalGerenteId = document.getElementById('modalGerenteId');
            const modalVendedorId = document.getElementById('modalVendedorId');

            if (modalGerenteId && modalVendedorId) {
                modalGerenteId.addEventListener('change', function() {
                    const gerenteSel = this.value;
                    Array.from(modalVendedorId.options).forEach(opt => {
                        if (!opt.value) return;
                        const gId = opt.getAttribute('data-gerente-id');
                        if (!gerenteSel || gId === gerenteSel) {
                            opt.style.display = '';
                        } else {
                            opt.style.display = 'none';
                            if (opt.selected) modalVendedorId.value = '';
                        }
                    });
                });
            }

            const buscaCliente = document.getElementById('buscaCliente');
            const selectCliente = document.getElementById('selectCliente');
            const selectGerenteVinculado = document.getElementById('selectGerenteVinculado');
            const selectVendedorVinculado = document.getElementById('selectVendedorVinculado');
            const valorOriginal = document.getElementById('valorOriginal');
            const dataVencimento = document.getElementById('dataVencimento');
            const valorCustas = document.getElementById('valorCustas');
            const btnCalcularCustas = document.getElementById('btnCalcularCustas');

            if (btnCalcularCustas) {
                btnCalcularCustas.addEventListener('click', function() {
                    const vOrig = parseFloat(valorOriginal.value.replace(/\./g, '').replace(',', '.')) || 0;
                    if (vOrig === 0 || !dataVencimento.value) {
                        alert('Informe o Valor Original e a Data de Vencimento para calcular as custas.');
                        return;
                    }

                    const dtVenc = new Date(dataVencimento.value);
                    const dtHoje = new Date();
                    const diffTime = Math.max(0, dtHoje - dtVenc);
                    const diffDias = Math.floor(diffTime / (1000 * 60 * 60 * 24));

                    const multa = vOrig * 0.02;
                    const juros = vOrig * (0.02 * (diffDias / 30));
                    const taxaBanco = 35.00;

                    const totalCustas = multa + juros + taxaBanco;

                    let v = totalCustas.toFixed(2);
                    let partes = v.split('.');
                    partes[0] = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                    valorCustas.value = partes.join(',');
                });
            }

            // BUSCA INTELIGENTE POR TRECHO (RAZÃO SOCIAL, NOME FANTASIA E CNPJ)
            buscaCliente.addEventListener('input', function() {
                const termo = this.value.toLowerCase().trim();
                let visiveis = 0;

                Array.from(selectCliente.options).forEach(opt => {
                    if (!opt.value) return;
                    const textoBusca = opt.getAttribute('data-texto-busca') || opt.text.toLowerCase();
                    if (textoBusca.includes(termo)) {
                        opt.style.display = '';
                        visiveis++;
                    } else {
                        opt.style.display = 'none';
                    }
                });

                selectCliente.style.display = visiveis > 0 && termo.length > 0 ? 'block' : 'none';
            });

            function atualizarVinculos(atualizarResponsaveis) {
                const opt = selectCliente.options[selectCliente.selectedIndex];
                if (opt && opt.value) {
                    if (atualizarResponsaveis) {
                        selectGerenteVinculado.value = opt.getAttribute('data-gerente-id') || '';
                        selectVendedorVinculado.value = opt.getAttribute('data-vendedor-id') || '';
                    }
                    // Extrai apenas o nome principal para o input de busca visual ou mantém limpo
                    buscaCliente.value = opt.text.trim();
                    selectCliente.style.display = 'none';
                }
            }

            selectCliente.addEventListener('change', function() {
                atualizarVinculos(true);
            });

            if (selectCliente.value) {
                atualizarVinculos(false);
            }

            document.querySelectorAll('.mascara-moeda').forEach(input => {
                input.addEventListener('input', function(e) {
                    let v = e.target.value.replace(/\D/g, '');
                    if (v === '') {
                        e.target.value = '0,00';
                        return;
                    }
                    v = (parseInt(v, 10) / 100).toFixed(2);
                    let partes = v.split('.');
                    partes[0] = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                    e.target.value = partes.join(',');
                });
            });

            const modalCnpjCpf = document.getElementById('modalCnpjCpf');
            if (modalCnpjCpf) {
                modalCnpjCpf.addEventListener('input', function(e) {
                    let v = e.target.value.replace(/\D/g, '');
                    if (v.length > 11) {
                        e.target.value = v.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5').slice(0, 18);
                    } else {
                        e.target.value = v.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/, '$1.$2.$3-$4').slice(0, 14);
                    }
                });
            }

            const btnBuscarCnpjModal = document.getElementById('btnBuscarCnpjModal');
            if (btnBuscarCnpjModal) {
                btnBuscarCnpjModal.addEventListener('click', async function() {
                    const cnpj = modalCnpjCpf.value.replace(/\D/g, '');
                    if (cnpj.length !== 14) {
                        alert('Informe um CNPJ válido com 14 dígitos.');
                        return;
                    }
                    btnBuscarCnpjModal.disabled = true;
                    btnBuscarCnpjModal.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                    try {
                        const res = await fetch(`/api/consultar-cnpj/${cnpj}`);
                        if (!res.ok) throw new Error();
                        const data = await res.json();
                        if (data.razao_social) document.getElementById('modalNome').value = data.razao_social;
                        if (data.nome_fantasia) document.getElementById('modalNomeFantasia').value = data.nome_fantasia;
                        if (data.municipio) document.getElementById('modalCidade').value = data.municipio;
                        if (data.uf) document.getElementById('modalUf').value = data.uf;
                    } catch (e) {
                        alert('CNPJ não encontrado ou erro na consulta.');
                    } finally {
                        btnBuscarCnpjModal.disabled = false;
                        btnBuscarCnpjModal.innerHTML = 'Buscar';
                    }
                });
            }

            const btnSalvarClienteModal = document.getElementById('btnSalvarClienteModal');
            if (btnSalvarClienteModal) {
                btnSalvarClienteModal.addEventListener('click', async function() {
                    const payload = {
                        tipo_pessoa: document.getElementById('modalTipoPessoa').value,
                        cnpj_cpf: document.getElementById('modalCnpjCpf').value,
                        nome: document.getElementById('modalNome').value,
                        nome_fantasia: document.getElementById('modalNomeFantasia').value,
                        email: document.getElementById('modalEmail').value,
                        telefone: document.getElementById('modalTelefone').value,
                        cidade: document.getElementById('modalCidade').value,
                        uf: document.getElementById('modalUf').value,
                        gerente_id: document.getElementById('modalGerenteId').value,
                        vendedor_id: document.getElementById('modalVendedorId').value
                    };

                    if (!payload.nome || !payload.email || !payload.gerente_id || !payload.vendedor_id) {
                        alert('Por favor, preencha a Razão Social, o E-mail, o Gerente e o Vendedor.');
                        return;
                    }

                    btnSalvarClienteModal.disabled = true;

                    try {
                        const res = await fetch('/api/clientes/novo', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json();

                        if (data.sucesso) {
                            const newOption = document.createElement('option');
                            newOption.value = data.cliente.id;
                            
                            let textoNovo = data.cliente.nome;
                            if (data.cliente.nome_fantasia) textoNovo += ' - ' + data.cliente.nome_fantasia;
                            if (data.cliente.cnpj_cpf) textoNovo += ' (' + data.cliente.cnpj_cpf + ')';

                            newOption.text = textoNovo;
                            newOption.setAttribute('data-texto-busca', textoNovo.toLowerCase());
                            newOption.setAttribute('data-gerente-id', data.cliente.gerente_id);
                            newOption.setAttribute('data-vendedor-id', data.cliente.vendedor_id);
                            newOption.setAttribute('data-gerente-nome', data.cliente.gerente_nome);
                            newOption.setAttribute('data-vendedor-nome', data.cliente.vendedor_nome);
                            newOption.selected = true;

                            selectCliente.appendChild(newOption);
                            atualizarVinculos(true);

                            const modalEl = document.getElementById('modalNovoCliente');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            modalInstance.hide();

                            document.getElementById('formModalCliente').reset();
                        } else {
                            alert(data.erro || 'Erro ao cadastrar cliente.');
                        }
                    } catch (e) {
                        alert('Erro de conexão ao salvar cliente.');
                    } finally {
                        btnSalvarClienteModal.disabled = false;
                    }
                });
            }

            const etapaFila = Number(new URLSearchParams(window.location.search).get('email_etapa'));
            if ([1, 2, 3].includes(etapaFila) && dadosBoleto.id) {
                prepararEmailRégua(etapaFila);
            }
        });
    </script>
</body>
</html>