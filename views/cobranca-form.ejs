<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Omnia - <%= conta && conta.id ? 'Editar' : 'Novo' %> Boleto</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">

    <!-- NAVBAR DA APLICAÇÃO -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold" href="/dashboard">
                <i class="fa-solid fa-layer-group text-primary me-2"></i>OMNIA
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard"><i class="fa-solid fa-chart-line me-1"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/cobranca"><i class="fa-solid fa-file-invoice-dollar me-1"></i> Cobrança</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/ocorrencias"><i class="fa-solid fa-triangle-exclamation me-1"></i> Ocorrências</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/clientes"><i class="fa-solid fa-users me-1"></i> Clientes</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <a href="/logout" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-right-from-bracket me-1"></i> Sair</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- CONTEÚDO PRINCIPAL -->
    <div class="container py-2">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white max-width-1000 mx-auto">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-1">
                        <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i><%= conta && conta.id ? 'Editar / Gerenciar' : 'Cadastrar Novo' %> Boleto
                    </h3>
                    <p class="text-muted small mb-0">Dados do documento e régua de acompanhamento de cobrança.</p>
                </div>
                <a href="/cobranca" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar</a>
            </div>

            <% if (locals.erro && erro) { %> <div class="alert alert-danger py-2"><%= erro %></div> <% } %>
            <% if (locals.sucesso && sucesso) { %> <div class="alert alert-success py-2"><%= sucesso %></div> <% } %>

            <form action="/cobranca/<%= conta && conta.id ? 'editar/' + conta.id : 'novo' %>" method="POST" id="formBoleto">
                
                <!-- SEÇÃO 1: DADOS DO DEVEDOR -->
                <div class="card mb-4 border-0 bg-light">
                    <div class="card-header bg-secondary text-white fw-semibold">
                        <i class="fa-solid fa-user me-2"></i>Dados do devedor
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Cliente *</label>
                                <div class="input-group">
                                    <input type="text" id="buscaCliente" class="form-control" placeholder="Digite um trecho do nome para filtrar..." autocomplete="off">
                                    <button type="button" class="btn btn-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#modalNovoCliente">
                                        <i class="fa-solid fa-user-plus me-1"></i> Cadastrar Cliente
                                    </button>
                                </div>
                                <select name="cliente_id" id="selectCliente" class="form-select mt-2" size="4" required style="display: none;">
                                    <% clientes.forEach(c => { %>
                                        <option value="<%= c.id %>" 
                                                data-gerente-id="<%= c.gerente_id %>" 
                                                data-vendedor-id="<%= c.vendedor_id %>"
                                                data-gerente-nome="<%= c.gerente_nome || '' %>" 
                                                data-vendedor-nome="<%= c.vendedor_nome || '' %>"
                                                <%= conta && conta.cliente_id == c.id ? 'selected' : '' %>>
                                            <%= c.nome %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Gerente Vinculado</label>
                                <input type="text" id="inputGerenteNome" class="form-control bg-white" placeholder="Selecione um cliente..." readonly>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Vendedor Vinculado</label>
                                <input type="text" id="inputVendedorNome" class="form-control bg-white" placeholder="Selecione um cliente..." readonly>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 2: DADOS DO DOCUMENTO -->
                <div class="card mb-4 border-0 bg-light">
                    <div class="card-header bg-secondary text-white fw-semibold">
                        <i class="fa-solid fa-file-lines me-2"></i>Dados do documento
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Número do Documento *</label>
                                <input type="text" name="numero_documento" class="form-control text-uppercase" value="<%= conta ? conta.numero_documento : '' %>" placeholder="Ex: 123456" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Data de Emissão</label>
                                <input type="date" name="data_emissao" class="form-control" value="<%= conta && conta.data_emissao ? new Date(conta.data_emissao).toISOString().split('T')[0] : '' %>">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Data de Vencimento *</label>
                                <input type="date" name="data_vencimento" id="dataVencimento" class="form-control" value="<%= conta && conta.data_vencimento ? new Date(conta.data_vencimento).toISOString().split('T')[0] : '' %>" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Banco</label>
                                <select name="banco" class="form-select">
                                    <option value="">Selecione um Banco...</option>
                                    <option value="Banco do Brasil" <%= conta && conta.banco === 'Banco do Brasil' ? 'selected' : '' %>>Banco do Brasil</option>
                                    <option value="Bradesco" <%= conta && conta.banco === 'Bradesco' ? 'selected' : '' %>>Bradesco</option>
                                    <option value="Caixa Econômica Federal" <%= conta && conta.banco === 'Caixa Econômica Federal' ? 'selected' : '' %>>Caixa Econômica Federal</option>
                                    <option value="Itaú" <%= conta && conta.banco === 'Itaú' ? 'selected' : '' %>>Itaú</option>
                                    <option value="Santander" <%= conta && conta.banco === 'Santander' ? 'selected' : '' %>>Santander</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Carteira</label>
                                <select name="carteira" class="form-select">
                                    <option value="Simples" <%= !conta || conta.carteira === 'Simples' ? 'selected' : '' %>>Simples</option>
                                    <option value="Descontada" <%= conta && conta.carteira === 'Descontada' ? 'selected' : '' %>>Descontada</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Valor Original *</label>
                                <input type="text" name="valor_original" id="valorOriginal" class="form-control text-end mascara-moeda" value="<%= conta ? conta.valor_original : '0,00' %>" placeholder="0,00" required>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 3: GESTÃO DE COBRANÇA E CARTÓRIO -->
                <div class="card mb-4 border-0 bg-light">
                    <div class="card-header bg-dark text-white fw-semibold">
                        <i class="fa-solid fa-bullhorn me-2"></i>Gestão de Cobrança e Cartório
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Situação do Boleto *</label>
                                <% if (conta && conta.id) { %>
                                    <select name="situacao_boleto" id="situacaoBoleto" class="form-select" required>
                                        <option value="Vencido" <%= conta.situacao_boleto === 'Vencido' ? 'selected' : '' %>>Vencido</option>
                                        <option value="Pago" <%= conta.situacao_boleto === 'Pago' ? 'selected' : '' %>>Pago</option>
                                        <option value="Pago com Pendência" <%= conta.situacao_boleto === 'Pago com Pendência' ? 'selected' : '' %>>Pago com Pendência</option>
                                    </select>
                                <% } else { %>
                                    <input type="text" class="form-control bg-light" value="Vencido" readonly disabled>
                                    <input type="hidden" name="situacao_boleto" value="Vencido">
                                <% } %>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Fase da Régua de Cobrança</label>
                                <select name="status_cobranca" class="form-select">
                                    <option value="Aviso 1 (Notificação)" <%= !conta || conta.status_cobranca === 'Aviso 1 (Notificação)' ? 'selected' : '' %>>Aviso 1 (Notificação)</option>
                                    <option value="Aviso 2 (Alerta Cartório)" <%= conta && conta.status_cobranca === 'Aviso 2 (Alerta Cartório)' ? 'selected' : '' %>>Aviso 2 (Alerta Cartório)</option>
                                    <option value="Aviso 3 (Aviso Final)" <%= conta && conta.status_cobranca === 'Aviso 3 (Aviso Final)' ? 'selected' : '' %>>Aviso 3 (Aviso Final)</option>
                                    <option value="Em Cartório / Negativado" <%= conta && conta.status_cobranca === 'Em Cartório / Negativado' ? 'selected' : '' %>>Em Cartório / Negativado</option>
                                    <option value="Custas Pendentes (Cartório)" <%= conta && conta.status_cobranca === 'Custas Pendentes (Cartório)' ? 'selected' : '' %>>Custas Pendentes (Cartório)</option>
                                    <option value="Concluído" <%= conta && conta.status_cobranca === 'Concluído' ? 'selected' : '' %>>Concluído</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Previsão de Pagamento</label>
                                <input type="date" name="data_previsao_pagamento" class="form-control" value="<%= conta && conta.data_previsao_pagamento ? new Date(conta.data_previsao_pagamento).toISOString().split('T')[0] : '' %>">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Data Envio Cartório/Negativação</label>
                                <input type="date" name="data_cartorio" id="dataCartorio" class="form-control" value="<%= conta && conta.data_cartorio ? new Date(conta.data_cartorio).toISOString().split('T')[0] : '' %>">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Valor Custas (Multa + Juros + R$ 35,00)</label>
                                <div class="input-group">
                                    <input type="text" name="valor_custas" id="valorCustas" class="form-control text-end mascara-moeda" value="<%= conta ? conta.valor_custas : '0,00' %>">
                                    <button type="button" class="btn btn-outline-secondary" id="btnCalcularCustas" title="Calcular Custas Padrão"><i class="fa-solid fa-calculator"></i></button>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Data Pagamento Boleto</label>
                                <input type="date" name="data_pagamento" class="form-control" value="<%= conta && conta.data_pagamento ? new Date(conta.data_pagamento).toISOString().split('T')[0] : '' %>">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Data Pagamento Custas</label>
                                <input type="date" name="data_pagamento_custas" class="form-control" value="<%= conta && conta.data_pagamento_custas ? new Date(conta.data_pagamento_custas).toISOString().split('T')[0] : '' %>">
                            </div>

                            <div class="col-md-8">
                                <label class="form-label small fw-bold">Observações Internas</label>
                                <input type="text" name="observacoes" class="form-control" value="<%= conta ? conta.observacoes || '' : '' %>" placeholder="Notas sobre o acordo ou cliente...">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <% if (conta && conta.id) { %>
                            <button type="button" class="btn btn-danger fw-semibold" onclick="confirmarExclusao()"><i class="fa-solid fa-trash me-1"></i> Excluir Boleto</button>
                        <% } %>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/cobranca" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4"><i class="fa-solid fa-save me-1"></i> <%= conta && conta.id ? 'Salvar Alterações' : 'Gravar Boleto' %></button>
                    </div>
                </div>
            </form>

            <% if (conta && conta.id) { %>
                <form id="formExcluirBoleto" action="/cobranca/excluir/<%= conta.id %>" method="POST" style="display: none;"></form>

                <!-- SEÇÃO DE AÇÕES RÁPIDAS E E-MAILS -->
                <div class="card mb-4 border-primary">
                    <div class="card-header bg-primary text-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-paper-plane me-2"></i>Ações e Disparo de E-mails da Régua</span>
                        <small>Utiliza o leitor de e-mail local do usuário</small>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="prepararEmailRégua(1)">
                                <i class="fa-solid fa-envelope me-1"></i> 1º E-mail (Aviso 1)
                            </button>
                            <button type="button" class="btn btn-outline-warning text-dark btn-sm" onclick="prepararEmailRégua(2)">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> 2º E-mail (Alerta Cartório)
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="prepararEmailRégua(3)">
                                <i class="fa-solid fa-gavel me-1"></i> 3º E-mail (Notificação Final + Vendedor)
                            </button>
                            <button type="button" class="btn btn-success btn-sm" onclick="prepararEmailAvisoComercial()">
                                <i class="fa-solid fa-user-check me-1"></i> Avisar Gerente/Vendedor (Liquidação/Custas)
                            </button>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO DE HISTÓRICO DE INTERAÇÕES (TIMELINE) -->
                <div class="card border-0 bg-light mb-3">
                    <div class="card-header bg-secondary text-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-comments me-2"></i>Registro de Interações (WhatsApp / Fone / E-mail)</span>
                        <button type="button" class="btn btn-light btn-sm fw-semibold text-dark" data-bs-toggle="modal" data-bs-target="#modalNovaInteracao">
                            <i class="fa-solid fa-plus me-1"></i> Nova Interação
                        </button>
                    </div>
                    <div class="card-body">
                        <% if (historico && historico.length > 0) { %>
                            <div class="list-group">
                                <% historico.forEach(h => { %>
                                    <div class="list-group-item list-group-item-action flex-column align-items-start">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1 fw-bold text-primary">
                                                <i class="fa-solid <%= h.canal === 'WhatsApp' ? 'fa-square-whatsapp text-success' : (h.canal === 'E-mail' ? 'fa-envelope text-info' : 'fa-phone text-warning') %> me-2"></i>
                                                <%= h.tipo_contato %> - <%= h.contato_nome || 'N/A' %>
                                            </h6>
                                            <small class="text-muted"><%= new Date(h.data_hora).toLocaleString('pt-BR') %></small>
                                        </div>
                                        <p class="mb-1 text-dark small"><%= h.resumo %></p>
                                        <small class="text-muted">Registrado por: <%= h.usuario_nome || 'Sistema' %></small>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-muted small mb-0 text-center py-2">Nenhuma interação registrada até o momento.</p>
                        <% } %>
                    </div>
                </div>
            <% } %>

        </div>
    </div>

    <!-- MODAL PARA REGISTRAR NOVA INTERAÇÃO -->
    <% if (conta && conta.id) { %>
        <div class="modal fade" id="modalNovaInteracao" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-secondary text-white">
                        <h5 class="modal-title fw-bold"><i class="fa-solid fa-comments me-2"></i>Registrar Interação</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/cobranca/historico/novo/<%= conta.id %>" method="POST">
                        <div class="modal-body bg-light">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Tipo de Contato</label>
                                    <select name="tipo_contato" class="form-select" required>
                                        <option value="Cliente">Cliente</option>
                                        <option value="Gerente">Gerente</option>
                                        <option value="Vendedor">Vendedor</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Canal</label>
                                    <select name="canal" class="form-select" required>
                                        <option value="Telefone">Telefone</option>
                                        <option value="WhatsApp">WhatsApp</option>
                                        <option value="E-mail">E-mail</option>
                                    </select>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold">Pessoa Contatada</label>
                                    <input type="text" name="contato_nome" class="form-control" placeholder="Ex: Sr. João (Financeiro)" required>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold">Resumo da Conversa</label>
                                    <textarea name="resumo" class="form-control" rows="3" placeholder="Descreva o que foi tratado..." required></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold">Gravar Registro</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% } %>

    <!-- MODAL DE COPIAR TEXTO DO E-MAIL (BACKUP CASO NÃO TENHA CLIENTE NATIVO) -->
    <div class="modal fade" id="modalCopiarEmail" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-copy me-2"></i>Conteúdo do E-mail para Envio</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Para:</label>
                        <input type="text" id="emailParaModal" class="form-control bg-white" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Em Cópia (CC):</label>
                        <input type="text" id="emailCcModal" class="form-control bg-white" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Assunto:</label>
                        <input type="text" id="emailAssuntoModal" class="form-control bg-white" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Corpo da Mensagem:</label>
                        <textarea id="emailTextoModal" class="form-control bg-white" rows="8" readonly></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-primary fw-semibold" onclick="copiarTextoEmail()"><i class="fa-solid fa-clipboard me-1"></i> Copiar Texto</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE CADASTRO RÁPIDO DE CLIENTE -->
    <div class="modal fade" id="modalNovoCliente" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2"></i>Cadastrar Novo Cliente Rápido</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bg-light">
                    <form id="formModalCliente">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Gerente *</label>
                                <select id="modalGerenteId" class="form-select" required>
                                    <option value="">Selecione o Gerente...</option>
                                    <% if (locals.gerentes) { gerentes.forEach(g => { %>
                                        <option value="<%= g.id %>"><%= g.nome_resumido %></option>
                                    <% }) } %>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Vendedor *</label>
                                <select id="modalVendedorId" class="form-select" required>
                                    <option value="">Selecione o Vendedor...</option>
                                    <% if (locals.vendedores) { vendedores.forEach(v => { %>
                                        <option value="<%= v.id %>"><%= v.nome_resumido %></option>
                                    <% }) } %>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Tipo de Pessoa *</label>
                                <select id="modalTipoPessoa" class="form-select" required>
                                    <option value="PJ (CNPJ)">PJ (CNPJ)</option>
                                    <option value="PF (CPF)">PF (CPF)</option>
                                </select>
                            </div>

                            <div class="col-md-8">
                                <label class="form-label small fw-bold">CPF / CNPJ *</label>
                                <div class="input-group">
                                    <input type="text" id="modalCnpjCpf" class="form-control" placeholder="00.000.000/0000-00" required>
                                    <button type="button" id="btnBuscarCnpjModal" class="btn btn-info text-white fw-semibold">Buscar</button>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Razão Social / Nome *</label>
                                <input type="text" id="modalNome" class="form-control" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nome Fantasia</label>
                                <input type="text" id="modalNomeFantasia" class="form-control">
                            </div>

                            <div class="col-md-8">
                                <label class="form-label small fw-bold">Cidade</label>
                                <input type="text" id="modalCidade" class="form-control">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">UF</label>
                                <input type="text" id="modalUf" class="form-control text-uppercase" maxlength="2">
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnSalvarClienteModal" class="btn btn-success fw-semibold"><i class="fa-solid fa-check me-1"></i> Gravar e Selecionar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS DA APLICAÇÃO -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function confirmarExclusao() {
            if (confirm('Tem certeza de que deseja excluir este boleto permanentemente?')) {
                document.getElementById('formExcluirBoleto').submit();
            }
        }

        const dadosBoleto = {
            id: "<%= conta ? conta.id : '' %>",
            numero_documento: "<%= conta ? conta.numero_documento : '' %>",
            valor_original: "<%= conta ? conta.valor_original : '0,00' %>",
            valor_custas: "<%= conta ? conta.valor_custas : '0,00' %>",
            data_vencimento: "<%= conta && conta.data_vencimento ? new Date(conta.data_vencimento).toLocaleDateString('pt-BR') : '' %>",
            situacao_boleto: "<%= conta ? conta.situacao_boleto : '' %>",
            cliente_nome: "<%= conta ? conta.cliente_nome : '' %>",
            cliente_email: "<%= conta ? conta.cliente_email : '' %>",
            gerente_email: "<%= conta ? conta.gerente_email : '' %>",
            vendedor_email: "<%= conta ? conta.vendedor_email : '' %>"
        };

        function dispararEmail(para, cc, assunto, corpo) {
            const mailtoUrl = `mailto:${encodeURIComponent(para)}?cc=${encodeURIComponent(cc)}&subject=${encodeURIComponent(assunto)}&body=${encodeURIComponent(corpo)}`;
            window.location.href = mailtoUrl;

            document.getElementById('emailParaModal').value = para;
            document.getElementById('emailCcModal').value = cc;
            document.getElementById('emailAssuntoModal').value = assunto;
            document.getElementById('emailTextoModal').value = corpo;

            setTimeout(() => {
                const modalCopiar = new bootstrap.Modal(document.getElementById('modalCopiarEmail'));
                modalCopiar.show();
            }, 1000);
        }

        function copiarTextoEmail() {
            const txt = document.getElementById('emailTextoModal');
            txt.select();
            document.execCommand('copy');
            alert('Texto copiado com sucesso para a área de transferência!');
        }

        function prepararEmailRégua(etapa) {
            let assunto = "";
            let corpo = "";
            const cc = [dadosBoleto.gerente_email, dadosBoleto.vendedor_email].filter(Boolean).join(',');

            if (etapa === 1) {
                assunto = `Aviso de Cobrança - Boleto Nº ${dadosBoleto.numero_documento}`;
                corpo = `Prezados,\n\nIdentificamos o boleto de número ${dadosBoleto.numero_documento} no valor de R$ ${dadosBoleto.valor_original}, vencido em ${dadosBoleto.data_vencimento}, pendente de pagamento.\n\nSolicitamos a gentileza de nos informar a previsão de pagamento ou nos enviar o comprovante de quitação.\n\nAtenciosamente,\nSetor de Cobrança - Omnia`;
            } else if (etapa === 2) {
                assunto = `RE: Lembrete de Cobrança - Boleto Nº ${dadosBoleto.numero_documento}`;
                corpo = `Prezados,\n\nReforçamos o contato anterior referente ao boleto Nº ${dadosBoleto.numero_documento} (Valor: R$ ${dadosBoleto.valor_original}, Vencimento: ${dadosBoleto.data_vencimento}).\n\nRessaltamos que os títulos não quitados sujeitam-se ao envio para cartório/negativação após 3 dias úteis do vencimento. Caso o pagamento já tenha sido efetuado, por favor nos envie o comprovante.\n\nAtenciosamente,\nSetor de Cobrança - Omnia`;
            } else if (etapa === 3) {
                assunto = `URGENTE: Notificação Final de Envio a Cartório - Boleto Nº ${dadosBoleto.numero_documento}`;
                corpo = `Prezados,\n\nInformamos que o boleto Nº ${dadosBoleto.numero_documento} no valor de R$ ${dadosBoleto.valor_original} será encaminhado para Cartório no próximo dia útil.\n\nSolicitamos o envio imediato do comprovante de pagamento caso já tenha sido liquidado.\n\nAtenciosamente,\nSetor de Cobrança - Omnia`;
            }

            dispararEmail(dadosBoleto.cliente_email, cc, assunto, corpo);
        }

        function prepararEmailAvisoComercial() {
            const destinatarios = [dadosBoleto.gerente_email, dadosBoleto.vendedor_email].filter(Boolean).join(',');
            let assunto = "";
            let corpo = "";

            if (dadosBoleto.situacao_boleto === 'Pago') {
                assunto = `AVISO DE LIQUIDAÇÃO: Cliente ${dadosBoleto.cliente_nome} - Boleto Nº ${dadosBoleto.numero_documento}`;
                corpo = `Prezados Gerente e Vendedor,\n\nO boleto Nº ${dadosBoleto.numero_documento} referente ao cliente ${dadosBoleto.cliente_nome} foi totalmente liquidado sem pendências.\n\nO cadastro do cliente está liberado para novos pedidos no sistema.\n\nAtenciosamente,\nSetor Financeiro - Omnia`;
            } else {
                assunto = `PENDÊNCIA DE CUSTAS: Cliente ${dadosBoleto.cliente_nome} - Boleto Nº ${dadosBoleto.numero_documento}`;
                corpo = `Prezados Gerente e Vendedor,\n\nO boleto Nº ${dadosBoleto.numero_documento} referente ao cliente ${dadosBoleto.cliente_nome} foi pago, porém possui pendência de custas bancárias/cartório no valor de R$ ${dadosBoleto.valor_custas}.\n\nInformamos que novos pedidos permanecerão bloqueados até a quitação integral destas custas.\n\nAtenciosamente,\nSetor Financeiro - Omnia`;
            }

            dispararEmail(destinatarios, '', assunto, corpo);
        }

        document.addEventListener('DOMContentLoaded', function() {
            const buscaCliente = document.getElementById('buscaCliente');
            const selectCliente = document.getElementById('selectCliente');
            const inputGerenteNome = document.getElementById('inputGerenteNome');
            const inputVendedorNome = document.getElementById('inputVendedorNome');
            const valorOriginal = document.getElementById('valorOriginal');
            const dataVencimento = document.getElementById('dataVencimento');
            const valorCustas = document.getElementById('valorCustas');
            const btnCalcularCustas = document.getElementById('btnCalcularCustas');

            if (btnCalcularCustas) {
                btnCalcularCustas.addEventListener('click', function() {
                    const vOrig = parseFloat(valorOriginal.value.replace(/\./g, '').replace(',', '.')) || 0;
                    if (vOrig === 0 || !dataVencimento.value) {
                        alert('Informe o Valor Original e a Data de Vencimento para calcular as custas.');
                        return;
                    }

                    const dtVenc = new Date(dataVencimento.value);
                    const dtHoje = new Date();
                    const diffTime = Math.max(0, dtHoje - dtVenc);
                    const diffDias = Math.floor(diffTime / (1000 * 60 * 60 * 24));

                    const multa = vOrig * 0.02;
                    const juros = vOrig * (0.02 * (diffDias / 30));
                    const taxaBanco = 35.00;

                    const totalCustas = multa + juros + taxaBanco;

                    let v = totalCustas.toFixed(2);
                    let partes = v.split('.');
                    partes[0] = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                    valorCustas.value = partes.join(',');
                });
            }

            buscaCliente.addEventListener('input', function() {
                const termo = this.value.toLowerCase().trim();
                let visiveis = 0;

                Array.from(selectCliente.options).forEach(opt => {
                    if (!opt.value) return;
                    const texto = opt.text.toLowerCase();
                    if (texto.includes(termo)) {
                        opt.style.display = '';
                        visiveis++;
                    } else {
                        opt.style.display = 'none';
                    }
                });

                selectCliente.style.display = visiveis > 0 && termo.length > 0 ? 'block' : 'none';
            });

            function atualizarVinculos() {
                const opt = selectCliente.options[selectCliente.selectedIndex];
                if (opt && opt.value) {
                    inputGerenteNome.value = opt.getAttribute('data-gerente-nome') || 'Não Vinculado';
                    inputVendedorNome.value = opt.getAttribute('data-vendedor-nome') || 'Não Vinculado';
                    buscaCliente.value = opt.text.trim();
                    selectCliente.style.display = 'none';
                } else {
                    inputGerenteNome.value = '';
                    inputVendedorNome.value = '';
                }
            }

            selectCliente.addEventListener('change', atualizarVinculos);

            if (selectCliente.value) {
                atualizarVinculos();
            }

            document.querySelectorAll('.mascara-moeda').forEach(input => {
                input.addEventListener('input', function(e) {
                    let v = e.target.value.replace(/\D/g, '');
                    if (v === '') {
                        e.target.value = '0,00';
                        return;
                    }
                    v = (parseInt(v, 10) / 100).toFixed(2);
                    let partes = v.split('.');
                    partes[0] = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                    e.target.value = partes.join(',');
                });
            });

            const modalCnpjCpf = document.getElementById('modalCnpjCpf');
            if (modalCnpjCpf) {
                modalCnpjCpf.addEventListener('input', function(e) {
                    let v = e.target.value.replace(/\D/g, '');
                    if (v.length > 11) {
                        e.target.value = v.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5').slice(0, 18);
                    } else {
                        e.target.value = v.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/, '$1.$2.$3-$4').slice(0, 14);
                    }
                });
            }

            const btnBuscarCnpjModal = document.getElementById('btnBuscarCnpjModal');
            if (btnBuscarCnpjModal) {
                btnBuscarCnpjModal.addEventListener('click', async function() {
                    const cnpj = modalCnpjCpf.value.replace(/\D/g, '');
                    if (cnpj.length !== 14) {
                        alert('Informe um CNPJ válido com 14 dígitos.');
                        return;
                    }
                    btnBuscarCnpjModal.disabled = true;
                    btnBuscarCnpjModal.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                    try {
                        const res = await fetch(`/api/consultar-cnpj/${cnpj}`);
                        if (!res.ok) throw new Error();
                        const data = await res.json();
                        if (data.razao_social) document.getElementById('modalNome').value = data.razao_social;
                        if (data.nome_fantasia) document.getElementById('modalNomeFantasia').value = data.nome_fantasia;
                        if (data.municipio) document.getElementById('modalCidade').value = data.municipio;
                        if (data.uf) document.getElementById('modalUf').value = data.uf;
                    } catch (e) {
                        alert('CNPJ não encontrado ou erro na consulta.');
                    } finally {
                        btnBuscarCnpjModal.disabled = false;
                        btnBuscarCnpjModal.innerHTML = 'Buscar';
                    }
                });
            }

            const btnSalvarClienteModal = document.getElementById('btnSalvarClienteModal');
            if (btnSalvarClienteModal) {
                btnSalvarClienteModal.addEventListener('click', async function() {
                    const payload = {
                        tipo_pessoa: document.getElementById('modalTipoPessoa').value,
                        cnpj_cpf: document.getElementById('modalCnpjCpf').value,
                        nome: document.getElementById('modalNome').value,
                        nome_fantasia: document.getElementById('modalNomeFantasia').value,
                        cidade: document.getElementById('modalCidade').value,
                        uf: document.getElementById('modalUf').value,
                        gerente_id: document.getElementById('modalGerenteId').value,
                        vendedor_id: document.getElementById('modalVendedorId').value
                    };

                    if (!payload.nome || !payload.gerente_id || !payload.vendedor_id) {
                        alert('Por favor, preencha a Razão Social, Gerente e Vendedor.');
                        return;
                    }

                    btnSalvarClienteModal.disabled = true;

                    try {
                        const res = await fetch('/api/clientes/novo', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json();

                        if (data.sucesso) {
                            const newOption = document.createElement('option');
                            newOption.value = data.cliente.id;
                            newOption.text = data.cliente.nome;
                            newOption.setAttribute('data-gerente-id', data.cliente.gerente_id);
                            newOption.setAttribute('data-vendedor-id', data.cliente.vendedor_id);
                            newOption.setAttribute('data-gerente-nome', data.cliente.gerente_nome);
                            newOption.setAttribute('data-vendedor-nome', data.cliente.vendedor_nome);
                            newOption.selected = true;

                            selectCliente.appendChild(newOption);
                            atualizarVinculos();

                            const modalEl = document.getElementById('modalNovoCliente');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            modalInstance.hide();

                            document.getElementById('formModalCliente').reset();
                        } else {
                            alert(data.erro || 'Erro ao cadastrar cliente.');
                        }
                    } catch (e) {
                        alert('Erro de conexão ao salvar cliente.');
                    } finally {
                        btnSalvarClienteModal.disabled = false;
                    }
                });
            }
        });
    </script>
</body>
</html>