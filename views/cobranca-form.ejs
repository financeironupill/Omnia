<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Omnia - <%= conta && conta.id ? 'Editar' : 'Novo' %> Boleto</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">

    <!-- NAVBAR DA APLICAÇÃO -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold" href="/dashboard">
                <i class="fa-solid fa-layer-group text-primary me-2"></i>OMNIA
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard"><i class="fa-solid fa-chart-line me-1"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/cobranca?<%= typeof filtrosCobrancaQuery === 'string' ? filtrosCobrancaQuery : '' %>"><i class="fa-solid fa-file-invoice-dollar me-1"></i> Cobrança</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/ocorrencias"><i class="fa-solid fa-triangle-exclamation me-1"></i> Ocorrências</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/clientes"><i class="fa-solid fa-users me-1"></i> Clientes</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <a href="/logout" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-right-from-bracket me-1"></i> Sair</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- CONTEÚDO PRINCIPAL -->
    <div class="container py-2">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white max-width-1000 mx-auto">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-1">
                        <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i><%= conta && conta.id ? 'Editar / Gerenciar' : 'Cadastrar Novo' %> Boleto
                    </h3>
                    <p class="text-muted small mb-0">Dados do documento e régua de acompanhamento de cobrança.</p>
                </div>
                <a href="/cobranca?<%= typeof filtrosCobrancaQuery === 'string' ? filtrosCobrancaQuery : '' %>" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar</a>
            </div>

            <% if (locals.erro && erro) { %> <div class="alert alert-danger py-2"><%= erro %></div> <% } %>
            <% if (locals.sucesso && sucesso) { %> <div class="alert alert-success py-2"><%= sucesso %></div> <% } %>

            <form action="/cobranca/<%= conta && conta.id ? 'editar/' + conta.id : 'novo' %><%= typeof filtrosCobrancaQuery === 'string' ? '?' + filtrosCobrancaQuery : '' %>" method="POST" id="formBoleto">
                
                <!-- SEÇÃO 1: DADOS DO DEVEDOR -->
                <div class="card mb-4 border-0 bg-light">
                    <div class="card-header bg-secondary text-white fw-semibold">
                        <i class="fa-solid fa-user me-2"></i>Dados do devedor
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Cliente (Razão Social, Nome Fantasia ou CNPJ) *</label>
                                <div class="input-group">
                                    <input type="text" id="buscaCliente" class="form-control" placeholder="Digite qualquer trecho da Razão Social, Fantasia ou CNPJ..." autocomplete="off">
                                    <button type="button" class="btn btn-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#modalNovoCliente">
                                        <i class="fa-solid fa-user-plus me-1"></i> Cadastrar Cliente
                                    </button>
                                </div>
                                <!-- Select ajustado para conter Razão Social, Fantasia e CNPJ para o filtro por trecho -->
                                <select name="cliente_id" id="selectCliente" class="form-select mt-2 font-monospace" size="4" required style="display: none;">
                                    <% clientes.forEach(c => { %>
                                        <% 
                                            let textoExibicao = c.nome;
                                            if (c.nome_fantasia) textoExibicao += ' - ' + c.nome_fantasia;
                                            if (c.cnpj_cpf) textoExibicao += ' (' + c.cnpj_cpf + ')';
                                        %>
                                        <option value="<%= c.id %>" 
                                                data-texto-busca="<%= textoExibicao.toLowerCase() %>"
                                                data-gerente-id="<%= c.gerente_id %>" 
                                                data-vendedor-id="<%= c.vendedor_id %>"
                                                data-gerente-nome="<%= c.gerente_nome || '' %>" 
                                                data-vendedor-nome="<%= c.vendedor_nome || '' %>"
                                                <%= conta && conta.cliente_id == c.id ? 'selected' : '' %>>
                                            <%= textoExibicao %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Gerente Vinculado</label>
                                <select name="gerente_id" id="selectGerenteVinculado" class="form-select">
                                    <option value="">Não vinculado</option>
                                    <% if (locals.gerentes) { gerentes.forEach(g => { %>
                                        <option value="<%= g.id %>" <%= conta && (conta.gerente_vinculado_id != null ? conta.gerente_vinculado_id : conta.gerente_id) == g.id ? 'selected' : '' %>><%= g.nome_resumido %></option>
                                    <% }) } %>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Vendedor Vinculado</label>
                                <select name="vendedor_id" id="selectVendedorVinculado" class="form-select">
                                    <option value="">Não vinculado</option>
                                    <% if (locals.vendedores) { vendedores.forEach(v => { %>
                                        <option value="<%= v.id %>" data-gerente-id="<%= v.gerente_id %>" <%= conta && (conta.vendedor_vinculado_id != null ? conta.vendedor_vinculado_id : conta.vendedor_id) == v.id ? 'selected' : '' %>><%= v.nome_resumido %></option>
                                    <% }) } %>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 2: DADOS DO DOCUMENTO -->
                <div class="card mb-4 border-0 bg-light">
                    <div class="card-header bg-secondary text-white fw-semibold">
                        <i class="fa-solid fa-file-lines me-2"></i>Dados do documento
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Número do Documento *</label>
                                <input type="text" name="numero_documento" class="form-control text-uppercase" value="<%= conta ? conta.numero_documento : '' %>" placeholder="Ex: 123456" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Data de Emissão *</label>
                                <input type="date" name="data_emissao" class="form-control" value="<%= conta && conta.data_emissao ? new Date(conta.data_emissao).toISOString().split('T')[0] : '' %>" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Data de Vencimento *</label>
                                <input type="date" name="data_vencimento" id="dataVencimento" class="form-control" value="<%= conta && conta.data_vencimento ? new Date(conta.data_vencimento).toISOString().split('T')[0] : '' %>" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Banco *</label>
                                <select name="banco" class="form-select" required>
                                    <option value="">Selecione um Banco...</option>
                                    <option value="Banco do Brasil" <%= conta && conta.banco === 'Banco do Brasil' ? 'selected' : '' %>>Banco do Brasil</option>
                                    <option value="Bradesco" <%= conta && conta.banco === 'Bradesco' ? 'selected' : '' %>>Bradesco</option>
                                    <option value="Caixa Econômica Federal" <%= conta && conta.banco === 'Caixa Econômica Federal' ? 'selected' : '' %>>Caixa Econômica Federal</option>
                                    <option value="Itaú" <%= conta && conta.banco === 'Itaú' ? 'selected' : '' %>>Itaú</option>
                                    <option value="Santander" <%= conta && conta.banco === 'Santander' ? 'selected' : '' %>>Santander</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Carteira</label>
                                <select name="carteira" class="form-select">
                                    <option value="Simples" <%= !conta || conta.carteira === 'Simples' ? 'selected' : '' %>>Simples</option>
                                    <option value="Descontada" <%= conta && conta.carteira === 'Descontada' ? 'selected' : '' %>>Descontada</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Valor Original *</label>
                                <input type="text" name="valor_original" id="valorOriginal" class="form-control text-end mascara-moeda" value="<%= conta ? conta.valor_original : '0,00' %>" placeholder="0,00" required>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 3: GESTÃO DE COBRANÇA E CARTÓRIO -->
                <div class="card mb-4 border-0 bg-light">
                    <div class="card-header bg-dark text-white fw-semibold">
                        <i class="fa-solid fa-bullhorn me-2"></i>Gestão de Cobrança e Cartório
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <% if (conta && conta.id) { %>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Fundo Perdido</label>
                                    <select name="fundo_perdido" class="form-select">
                                        <option value="false" <%= String(conta.fundo_perdido) === 'true' ? '' : 'selected' %>>Não</option>
                                        <option value="true" <%= String(conta.fundo_perdido) === 'true' ? 'selected' : '' %>>Sim</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Situação do Boleto *</label>
                                    <select name="situacao_boleto" id="situacaoBoleto" class="form-select" required>
                                        <option value="Vencido" <%= conta.situacao_boleto === 'Vencido' ? 'selected' : '' %>>Vencido</option>
                                        <option value="Pago" <%= conta.situacao_boleto === 'Pago' ? 'selected' : '' %>>Pago</option>
                                        <option value="Pago com Pendência" <%= conta.situacao_boleto === 'Pago com Pendência' ? 'selected' : '' %>>Pago com Pendência</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Fase da Régua de Cobrança</label>
                                    <select name="status_cobranca" class="form-select">
                                        <option value="Aguardando Régua" <%= conta.status_cobranca === 'Aguardando Régua' ? 'selected' : '' %>>Aguardando Régua</option>
                                        <option value="Aviso 1 (Notificação)" <%= conta.status_cobranca === 'Aviso 1 (Notificação)' ? 'selected' : '' %>>Aviso 1 (Notificação)</option>
                                        <option value="Aviso 2 (Alerta Cartório)" <%= conta.status_cobranca === 'Aviso 2 (Alerta Cartório)' ? 'selected' : '' %>>Aviso 2 (Alerta Cartório)</option>
                                        <option value="Aviso 3 (Aviso Final)" <%= conta.status_cobranca === 'Aviso 3 (Aviso Final)' ? 'selected' : '' %>>Aviso 3 (Aviso Final)</option>
                                        <option value="Em Cartório / Negativado" <%= conta.status_cobranca === 'Em Cartório / Negativado' ? 'selected' : '' %>>Em Cartório / Negativado</option>
                                        <option value="Custas Pendentes (Cartório)" <%= conta.status_cobranca === 'Custas Pendentes (Cartório)' ? 'selected' : '' %>>Custas Pendentes (Cartório)</option>
                                        <option value="Concluído" <%= conta.status_cobranca === 'Concluído' ? 'selected' : '' %>>Concluído</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Previsão de Pagamento</label>
                                    <input type="date" name="data_previsao_pagamento" class="form-control" value="<%= conta.data_previsao_pagamento ? new Date(conta.data_previsao_pagamento).toISOString().split('T')[0] : '' %>">
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Data Envio Cartório/Negativação</label>
                                    <input type="date" name="data_cartorio" id="dataCartorio" class="form-control" value="<%= conta.data_cartorio ? new Date(conta.data_cartorio).toISOString().split('T')[0] : '' %>">
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Valor Custas (Multa + Juros + 35,00)</label>
                                    <div class="input-group">
                                        <input type="text" name="valor_custas" id="valorCustas" class="form-control text-end mascara-moeda" value="<%= conta.valor_custas %>">
                                        <button type="button" class="btn btn-outline-secondary" id="btnCalcularCustas" title="Calcular Custas Padrão"><i class="fa-solid fa-calculator"></i></button>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Data Pagamento Boleto</label>
                                    <input type="date" name="data_pagamento" class="form-control" value="<%= conta.data_pagamento ? new Date(conta.data_pagamento).toISOString().split('T')[0] : '' %>">
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Data Pagamento Custas</label>
                                    <input type="date" name="data_pagamento_custas" class="form-control" value="<%= conta.data_pagamento_custas ? new Date(conta.data_pagamento_custas).toISOString().split('T')[0] : '' %>">
                                </div>

                                <div class="col-md-8">
                                    <label class="form-label small fw-bold">Observações Internas</label>
                                    <input type="text" name="observacoes" class="form-control" value="<%= conta.observacoes || '' %>" placeholder="Notas sobre o acordo ou cliente...">
                                </div>
                            <% } else { %>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Situação do Boleto *</label>
                                    <input type="text" class="form-control bg-light" value="Vencido" readonly disabled>
                                    <input type="hidden" name="situacao_boleto" value="Vencido">
                                    <input type="hidden" name="status_cobranca" value="Aguardando Régua">
                                </div>

                                <div class="col-md-8">
                                    <label class="form-label small fw-bold">Observações Internas</label>
                                    <input type="text" name="observacoes" class="form-control" value="<%= conta ? conta.observacoes || '' : '' %>" placeholder="Notas iniciais sobre o boleto ou cliente...">
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <% if (conta && conta.id) { %>
                <!-- SEÇÃO 4: CONTROLO DE COMISSÃO E ESTORNO -->
                <div class="card mb-4 border-0 bg-light">
                    <div class="card-header bg-dark text-white fw-semibold">
                        <i class="fa-solid fa-hand-holding-dollar me-2"></i>Controlo de Comissão e Estorno
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Data do Estorno</label>
                                <input type="date" name="data_estorno" id="dataEstorno" class="form-control" 
                                    value="<%= conta && conta.data_estorno ? new Date(conta.data_estorno).toISOString().split('T')[0] : '' %>">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Valor Estornado (R$)</label>
                                <input type="text" name="valor_estornado" id="valorEstornado" class="form-control text-end mascara-moeda" 
                                    value="<%= conta && conta.valor_estornado ? conta.valor_estornado : '' %>" placeholder="0,00">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Data de Restituição (Devolução ao Vendedor)</label>
                                <input type="date" name="data_restituicao" id="dataRestituicao" class="form-control" 
                                    value="<%= conta && conta.data_restituicao ? new Date(conta.data_restituicao).toISOString().split('T')[0] : '' %>">
                                <div class="form-text small">Preencher após o cliente quitar o débito em cartório.</div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Observações de Estorno</label>
                                <textarea name="observacoes_estorno" id="observacoesEstorno" class="form-control" rows="2" placeholder="Detalhes adicionais sobre o estorno da comissão..."><%= conta ? (conta.observacoes_estorno || conta.estorno_obs || '') : '' %></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>

                <div class="d-flex justify-content-end align-items-center gap-2 mb-4">
                    <a href="/cobranca?<%= typeof filtrosCobrancaQuery === 'string' ? filtrosCobrancaQuery : '' %>" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-semibold px-4"><i class="fa-solid fa-save me-1"></i> <%= conta && conta.id ? 'Salvar Alterações' : 'Gravar Boleto' %></button>
                </div>
            </form>

            <% if (conta && conta.id) { %>
                <!-- SEÇÃO DE AÇÕES RÁPIDAS E E-MAILS -->
                <div class="card mb-4 border-primary">
                    <div class="card-header bg-primary text-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-paper-plane me-2"></i>Ações e Disparo de E-mails da Régua</span>
                        <small>Utiliza o leitor de e-mail local do usuário</small>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" id="btnAviso1" class="btn btn-outline-primary btn-sm" onclick="prepararEmailAviso1()">
                                <i class="fa-solid fa-envelope me-1"></i> 1º E-mail (Aviso 1)
                            </button>
                            <button type="button" class="btn btn-outline-warning text-dark btn-sm" onclick="prepararEmailRégua(2)">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> 2º E-mail (Alerta Cartório)
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="prepararEmailRégua(3)">
                                <i class="fa-solid fa-gavel me-1"></i> 3º E-mail (Notificação Final + Vendedor)
                            </button>
                            <button type="button" class="btn btn-success btn-sm" onclick="prepararEmailAvisoComercial()">
                                <i class="fa-solid fa-user-check me-1"></i> Avisar Gerente/Vendedor (Liquidação/Custas)
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="prepararEmailRetornado()">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> Notificar E-mail Retornado (Gerente/Vendedor)
                            </button>
                            <a href="/cobranca/nota-debito/<%= conta.id %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark btn-sm">
                                <i class="fa-solid fa-file-pdf me-1"></i> Gerar Nota de Débito (PDF)
                            </a>
                            <form action="/cobranca/nota-debito/<%= conta.id %>/registrar" method="POST" target="_blank">
                                <button type="submit" class="btn btn-dark btn-sm">
                                    <i class="fa-solid fa-clipboard-check me-1"></i> Registrar e Gerar PDF
                                </button>
                            </form>
                        </div>
                        <div id="emailAvisoFeedback" class="alert d-none mt-3 mb-0" role="status" aria-live="polite"></div>
                    </div>
                </div>

                <!-- SEÇÃO DE HISTÓRICO DE INTERAÇÕES (TIMELINE) -->
                <div class="card border-0 bg-light mb-3">
                    <div class="card-header bg-secondary text-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-comments me-2"></i>Registro de Interações (WhatsApp / Fone / E-mail)</span>
                        <button type="button" class="btn btn-light btn-sm fw-semibold text-dark" data-bs-toggle="modal" data-bs-target="#modalNovaInteracao">
                            <i class="fa-solid fa-plus me-1"></i> Nova Interação
                        </button>
                    </div>
                    <div class="card-body">
                        <% if (historico && historico.length > 0) { %>
                            <div class="list-group" id="listaHistoricoInteracoes">
                                <% historico.forEach(h => { %>
                                    <div class="list-group-item list-group-item-action flex-column align-items-start">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1 fw-bold text-primary">
                                                <i class="fa-solid <%= h.canal === 'WhatsApp' ? 'fa-square-whatsapp text-success' : (h.canal === 'E-mail' ? 'fa-envelope text-info' : 'fa-phone text-warning') %> me-2"></i>
                                                <%= h.tipo_contato %> - <%= h.contato_nome || 'N/A' %>
                                            </h6>
                                            <div class="text-end">
                                                <% if (h.status) { %><span class="badge <%= h.status === 'Confirmado' ? 'bg-success' : 'bg-secondary' %> me-2"><%= h.status %></span><% } %>
                                                <small class="text-muted"><%= new Date(h.data_hora).toLocaleString('pt-BR') %></small>
                                                <button type="button" class="btn btn-outline-secondary btn-sm ms-2"
                                                    data-bs-toggle="modal" data-bs-target="#modalEditarInteracao"
                                                    data-historico-id="<%= h.id %>"
                                                    data-boleto-id="<%= conta.id %>"
                                                    data-tipo-contato="<%= h.tipo_contato %>"
                                                    data-canal="<%= h.canal %>"
                                                    data-contato-nome="<%= h.contato_nome || '' %>"
                                                    data-resumo="<%= h.resumo || '' %>"
                                                    onclick="preencherEdicaoInteracao(this)" title="Editar interação">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <form action="/cobranca/historico/excluir/<%= conta.id %>/<%= h.id %>" method="POST" class="d-inline"
                                                    onsubmit="return confirm('Deseja realmente excluir esta interação?')">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm ms-1" title="Excluir interação">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                        <p class="mb-1 text-dark small"><%= h.resumo %></p>
                                        <small class="text-muted">Registrado por: <%= h.usuario_nome || 'Sistema' %></small>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
