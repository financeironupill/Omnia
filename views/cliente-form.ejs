<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Omnia - <%= cliente ? 'Editar' : 'Novo' %> Cliente</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2 text-warning"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="/clientes" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar aos Clientes</a>
        </div>
    </nav>

    <div class="container py-4">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white max-width-900 mx-auto">
            <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-users text-primary me-2"></i><%= cliente ? 'Editar' : 'Cadastrar Novo' %> Cliente</h3>
            <p class="text-muted small mb-4">Preencha os dados cadastrais, localização, dados bancários e associação de gerência/venda.</p>

            <% if (locals.erro && erro) { %> <div class="alert alert-danger py-2"><%= erro %></div> <% } %>

            <form action="/clientes/<%= cliente && cliente.id ? 'editar/' + cliente.id : 'novo' %>" method="POST">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Gerente *</label>
                        <select name="gerente_id" id="selectGerente" class="form-select" required>
                            <option value="">Selecione o Gerente...</option>
                            <% gerentes.forEach(g => { %>
                                <option value="<%= g.id %>" <%= cliente && cliente.gerente_id == g.id ? 'selected' : '' %>><%= g.nome_resumido %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Vendedor *</label>
                        <select name="vendedor_id" id="selectVendedor" class="form-select" required>
                            <option value="">Selecione o Vendedor...</option>
                            <% vendedores.forEach(v => { %>
                                <option value="<%= v.id %>" data-gerente="<%= v.gerente_id %>" <%= cliente && cliente.vendedor_id == v.id ? 'selected' : '' %>><%= v.nome_resumido %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Tipo de Pessoa *</label>
                        <select name="tipo_pessoa" id="tipoPessoa" class="form-select" required>
                            <option value="PJ (CNPJ)" <%= (cliente && cliente.tipo_pessoa === 'PJ (CNPJ)') ? 'selected' : '' %>>PJ (CNPJ)</option>
                            <option value="PF (CPF)" <%= (cliente && cliente.tipo_pessoa === 'PF (CPF)') ? 'selected' : '' %>>PF (CPF)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">CPF / CNPJ *</label>
                        <div class="input-group">
                            <input type="text" name="cnpj_cpf" id="campoCnpjCpf" class="form-control" value="<%= cliente ? cliente.cnpj_cpf : '' %>" placeholder="00.000.000/0000-00" required>
                            <button type="button" id="btnBuscarCnpj" class="btn btn-info text-white fw-semibold">Buscar</button>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label small fw-bold">Razão Social / Nome *</label>
                        <input type="text" name="nome" id="inputRazaoSocial" class="form-control" value="<%= cliente ? cliente.nome : '' %>" required>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Nome Fantasia</label>
                        <input type="text" name="nome_fantasia" id="inputNomeFantasia" class="form-control" value="<%= cliente ? cliente.nome_fantasia : '' %>">
                    </div>

                    <div class="col-md-5">
                        <label class="form-label small fw-bold">Cidade</label>
                        <input type="text" name="cidade" id="inputCidade" class="form-control" value="<%= cliente ? cliente.cidade : '' %>">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold">UF</label>
                        <input type="text" name="uf" id="inputUf" class="form-control text-uppercase" maxlength="2" value="<%= cliente ? cliente.uf : '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Contacto</label>
                        <input type="text" name="contato" class="form-control" value="<%= cliente ? cliente.contato : '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Telefone</label>
                        <input type="text" name="telefone" id="inputTelefone" class="form-control" value="<%= cliente ? cliente.telefone : '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">E-mail</label>
                        <input type="email" name="email" id="inputEmail" class="form-control" value="<%= cliente ? cliente.email : '' %>">
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="/clientes" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-semibold px-4"><i class="fa-solid fa-save me-1"></i> Gravar Cliente</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const campoCnpjCpf = document.getElementById('campoCnpjCpf');
            const btnBuscarCnpj = document.getElementById('btnBuscarCnpj');
            const inputRazaoSocial = document.getElementById('inputRazaoSocial');
            const inputNomeFantasia = document.getElementById('inputNomeFantasia');
            const inputCidade = document.getElementById('inputCidade');
            const inputUf = document.getElementById('inputUf');
            const inputTelefone = document.getElementById('inputTelefone');
            const inputEmail = document.getElementById('inputEmail');

            function aplicarMascara(v) {
                v = v.replace(/\D/g, '');
                if (v.length > 11) {
                    return v.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5').slice(0, 18);
                } else {
                    return v.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/, '$1.$2.$3-$4').slice(0, 14);
                }
            }

            campoCnpjCpf.addEventListener('input', function(e) {
                e.target.value = aplicarMascara(e.target.value);
            });

            if (campoCnpjCpf.value) {
                campoCnpjCpf.value = aplicarMascara(campoCnpjCpf.value);
            }

            btnBuscarCnpj.addEventListener('click', async function() {
                const cnpjLimpo = campoCnpjCpf.value.replace(/\D/g, '');
                if (cnpjLimpo.length !== 14) {
                    alert('Por favor, informe um CNPJ válido com 14 dígitos.');
                    return;
                }

                btnBuscarCnpj.disabled = true;
                btnBuscarCnpj.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                try {
                    const response = await fetch(`/api/consultar-cnpj/${cnpjLimpo}`);
                    if (!response.ok) {
                        alert('CNPJ não encontrado ou erro na consulta.');
                        return;
                    }

                    const data = await response.json();
                    if (data.razao_social) inputRazaoSocial.value = data.razao_social;
                    if (data.nome_fantasia) inputNomeFantasia.value = data.nome_fantasia;
                    if (data.municipio) inputCidade.value = data.municipio;
                    if (data.uf) inputUf.value = data.uf;
                    if (data.ddd_telefone_1) inputTelefone.value = data.ddd_telefone_1;
                    if (data.email) inputEmail.value = data.email;

                } catch (err) {
                    console.error(err);
                    alert('Erro ao consultar o CNPJ.');
                } finally {
                    btnBuscarCnpj.disabled = false;
                    btnBuscarCnpj.innerHTML = 'Buscar';
                }
            });
        });
    </script>
</body>
</html>