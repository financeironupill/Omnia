<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title><%= cliente ? 'Editar Cliente' : 'Novo Cliente' %> - Omnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }</style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="/clientes" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar aos Clientes</a>
        </div>
    </nav>

    <div class="container-fluid px-4" style="max-width: 1000px;">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
            <h3 class="fw-bold text-primary mb-1"><i class="fa-solid fa-address-book me-2"></i><%= cliente ? 'Editar Cliente' : 'Cadastrar Novo Cliente' %></h3>
            <p class="text-muted small mb-3">Preencha os dados cadastrais, morada, dados bancários e vinculação de gerência/venda.</p>
            <hr class="text-muted mb-4">

            <form action="<%= cliente ? '/clientes/editar/' + cliente.id : '/clientes/novo' %>" method="POST" id="clienteForm">
                <div class="row g-3">
                    <!-- SEÇÃO DE VINCULAÇÃO (Gerente e Vendedor) -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Gerente</label>
                        <select name="gerente_id" id="gerenteSelect" class="form-select">
                            <option value="">Selecione o gerente...</option>
                            <% gerentes.forEach(g => { %>
                                <option value="<%= g.id %>" <%= (cliente && cliente.gerente_id === g.id) ? 'selected' : '' %>><%= g.nome_resumido %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Vendedor</label>
                        <select name="vendedor_id" id="vendedorSelect" class="form-select">
                            <option value="">Selecione o vendedor...</option>
                            <% vendedores.forEach(v => { %>
                                <option value="<%= v.id %>" data-gerente="<%= v.gerente_id %>" <%= (cliente && cliente.vendedor_id === v.id) ? 'selected' : '' %>><%= v.nome_resumido %></option>
                            <% }) %>
                        </select>
                    </div>

                    <hr class="my-3">

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Tipo de Pessoa <span class="text-danger">*</span></label>
                        <select name="tipo_pessoa" class="form-select" required>
                            <option value="PJ" <%= (cliente && cliente.tipo_pessoa === 'PJ') ? 'selected' : '' %>>PJ (CNPJ)</option>
                            <option value="PF" <%= (cliente && cliente.tipo_pessoa === 'PF') ? 'selected' : '' %>>PF (CPF)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">CPF / CNPJ <span class="text-danger">*</span></label>
                        <input type="text" name="cnpj_cpf" class="form-control" placeholder="Apenas números" value="<%= cliente ? cliente.cnpj_cpf : '' %>" required>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Razão Social / Nome <span class="text-danger">*</span></label>
                        <input type="text" name="nome" class="form-control" placeholder="Nome principal" value="<%= cliente ? cliente.nome : '' %>" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nome Fantasia</label>
                        <input type="text" name="nome_fantasia" class="form-control" placeholder="Nome fantasia (se houver)" value="<%= cliente ? cliente.nome_fantasia : '' %>">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Cidade</label>
                        <input type="text" name="cidade" class="form-control" placeholder="Cidade" value="<%= cliente ? cliente.cidade : '' %>">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">UF</label>
                        <input type="text" name="uf" class="form-control" placeholder="Ex: SP" maxlength="2" value="<%= cliente ? cliente.uf : '' %>" style="text-transform: uppercase;">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Contato</label>
                        <input type="text" name="contato" class="form-control" placeholder="Nome do contacto" value="<%= cliente ? cliente.contato : '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Telefone</label>
                        <input type="text" name="telefone" class="form-control" placeholder="(00) 00000-0000" value="<%= cliente ? cliente.telefone : '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">E-mail</label>
                        <input type="email" name="email" class="form-control" placeholder="email@empresa.com" value="<%= cliente ? cliente.email : '' %>">
                    </div>

                    <hr class="my-3">

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Banco</label>
                        <input type="text" name="banco" class="form-control" placeholder="Nome do banco" value="<%= cliente ? cliente.banco : '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Agência</label>
                        <input type="text" name="agencia" class="form-control" placeholder="Agência" value="<%= cliente ? cliente.agencia : '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Conta</label>
                        <input type="text" name="conta" class="form-control" placeholder="Conta" value="<%= cliente ? cliente.conta : '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Tipo Chave PIX</label>
                        <select name="tipo_chave_pix" class="form-select">
                            <option value="">Selecione...</option>
                            <option value="CPF" <%= (cliente && cliente.tipo_chave_pix === 'CPF') ? 'selected' : '' %>>CPF</option>
                            <option value="CNPJ" <%= (cliente && cliente.tipo_chave_pix === 'CNPJ') ? 'selected' : '' %>>CNPJ</option>
                            <option value="E-mail" <%= (cliente && cliente.tipo_chave_pix === 'E-mail') ? 'selected' : '' %>>E-mail</option>
                            <option value="Telefone" <%= (cliente && cliente.tipo_chave_pix === 'Telefone') ? 'selected' : '' %>>Telefone</option>
                            <option value="Aleatória" <%= (cliente && cliente.tipo_chave_pix === 'Aleatória') ? 'selected' : '' %>>Aleatória</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Chave PIX</label>
                        <input type="text" name="chave_pix" class="form-control" placeholder="Insira a chave PIX" value="<%= cliente ? cliente.chave_pix : '' %>">
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-primary fw-semibold px-4"><i class="fa-solid fa-check me-1"></i> Gravar Cliente</button>
                        <a href="/clientes" class="btn btn-secondary ms-2">Cancelar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- SCRIPT DE LÓGICA DE VINCULAÇÃO (Gerente <-> Vendedor) -->
    <script>
        const gerenteSelect = document.getElementById('gerenteSelect');
        const vendedorSelect = document.getElementById('vendedorSelect');
        
        // Guardar todas as opções originais de vendedores
        const todasOpcoesVendedores = Array.from(vendedorSelect.options);

        function atualizarFiltros(origem) {
            const gerenteId = gerenteSelect.value;
            const vendedorId = vendedorSelect.value;

            if (origem === 'vendedor' && vendedorId) {
                // Se o utilizador escolheu o vendedor primeiro, preenche o gerente automaticamente e bloqueia
                const vendedorOption = vendedorSelect.options[vendedorSelect.selectedIndex];
                const gerenteVinculado = vendedorOption.getAttribute('data-gerente');
                if (gerenteVinculado) {
                    gerenteSelect.value = gerenteVinculado;
                    gerenteSelect.setAttribute('disabled', 'true'); // Bloqueia para não poder alterar
                }
            } else if (origem === 'gerente') {
                // Se o utilizador escolheu o gerente primeiro, desbloqueia o gerente e filtra os vendedores
                gerenteSelect.removeAttribute('disabled');
                
                vendedorSelect.innerHTML = '<option value="">Selecione o vendedor...</option>';
                todasOpcoesVendedores.forEach(opt => {
                    if (!opt.value) return;
                    const gVinculado = opt.getAttribute('data-gerente');
                    if (!gerenteId || gVinculado === gerenteId) {
                        vendedorSelect.appendChild(opt.cloneNode(true));
                    }
                });
            }
        }

        gerenteSelect.addEventListener('change', () => atualizarFiltros('gerente'));
        vendedorSelect.addEventListener('change', () => atualizarFiltros('vendedor'));

        // Garantir que o campo disabled vai no submit para o backend receber o ID do gerente
        document.getElementById('clienteForm').addEventListener('submit', () => {
            gerenteSelect.removeAttribute('disabled');
        });
    </script>
</body>
</html>