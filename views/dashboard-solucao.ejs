<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Omnia - Módulo Solução</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { 
            background-color: #f4f6f9; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
        }
        .card-modulo {
            transition: all 0.25s ease-in-out;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            text-decoration: none;
            color: inherit;
        }
        .card-modulo:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
            border-color: #0d6efd;
            color: inherit;
        }
        .icon-box {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
        }
    </style>
</head>
<body>
    <!-- BARRA SUPERIOR PADRÃO OMNIA -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2 text-warning"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="/dashboard" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar ao Dashboard Principal</a>
        </div>
    </nav>

    <div class="container py-4">
        <!-- CABEÇALHO DA PÁGINA -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-handshake-angle text-primary me-2"></i>Módulo Solução</h2>
                <p class="text-muted mb-0">Gestão integrada de pós-venda, ocorrências, clientes e transportadoras parceiras.</p>
            </div>
        </div>

        <!-- GRID DE MÓDULOS -->
        <div class="row g-4">
            <!-- GESTÃO DE OCORRÊNCIAS -->
            <div class="col-md-4">
                <a href="/ocorrencias" class="card card-modulo shadow-sm h-100 p-4 bg-white d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="icon-box bg-primary bg-opacity-10 text-primary">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>
                            <span class="badge bg-primary rounded-pill">Pós-Venda</span>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Gestão de Ocorrências</h4>
                        <p class="text-muted small">Controlo e acompanhamento de reclamações, divergências de transporte, devoluções e custos financeiros associados.</p>
                    </div>
                    <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center text-primary fw-semibold">
                        <span>Aceder Ocorrências</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </a>
            </div>

            <!-- CLIENTES -->
            <div class="col-md-4">
                <a href="/clientes?origem=solucao" class="card card-modulo shadow-sm h-100 p-4 bg-white d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="icon-box bg-success bg-opacity-10 text-success">
                                <i class="fa-solid fa-users"></i>
                            </div>
                            <span class="badge bg-success rounded-pill">Base Geral</span>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Clientes</h4>
                        <p class="text-muted small">Consultar, cadastrar e gerir a base centralizada de clientes, gerentes e vendedores vinculados.</p>
                    </div>
                    <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center text-success fw-semibold">
                        <span>Consultar Clientes</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </a>
            </div>

            <!-- TRANSPORTADORAS -->
            <div class="col-md-4">
                <a href="/transportadoras" class="card card-modulo shadow-sm h-100 p-4 bg-white d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="icon-box bg-warning bg-opacity-10 text-warning">
                                <i class="fa-solid fa-truck-fast"></i>
                            </div>
                            <span class="badge bg-warning text-dark rounded-pill">Logística</span>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Transportadoras</h4>
                        <p class="text-muted small">Gestão de transportadoras parceiras, dados de contacto, CNPJ e integração com ocorrências.</p>
                    </div>
                    <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center text-warning fw-semibold">
                        <span>Gerir Transportadoras</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>
</body>
</html>