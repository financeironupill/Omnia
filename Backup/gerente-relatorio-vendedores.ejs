<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Relatório de Vendedores por Gerente - Omnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        @media print {
            .no-print { display: none !important; }
            body { background-color: #fff !important; }
            .card { border: none !important; box-shadow: none !important; }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm mb-4 no-print">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/dashboard"><i class="fa-solid fa-cube me-2"></i>OMNIA <small class="text-muted fs-6">Enterprise</small></a>
            <a href="/gerentes" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Voltar aos Gerentes</a>
        </div>
    </nav>

    <div class="container-fluid px-4" style="max-width: 1200px;">
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-0" style="color: #6f42c1!important;"><i class="fa-solid fa-file-lines me-2"></i>Relatório de Vendedores Vinculados</h3>
                    <p class="text-muted small mb-0">Listagem detalhada da equipa de vendas associada à gerência selecionada.</p>
                </div>
                <button onclick="window.print()" class="btn btn-outline-dark fw-semibold shadow-sm no-print"><i class="fa-solid fa-print me-1"></i> Imprimir Relatório</button>
            </div>

            <hr class="text-muted mb-4">

            <!-- Cabeçalho com Informações do Gerente -->
            <div class="p-3 mb-4 rounded-3 bg-light border">
                <div class="row">
                    <div class="col-md-4">
                        <span class="text-muted small d-block">Gerente Responsável</span>
                        <h5 class="fw-bold text-dark mb-0"><%= gerente.nome_completo %></h5>
                        <small class="badge text-white mt-1" style="background-color: #6f42c1;"><%= gerente.nome_resumido %></small>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted small d-block">Contactos</span>
                        <div><i class="fa-solid fa-phone text-muted me-1 small"></i> <%= gerente.telefone || '--' %></div>
                        <div><i class="fa-solid fa-envelope text-muted me-1 small"></i> <%= gerente.email || '--' %></div>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted small d-block">Dados Bancários / PIX</span>
                        <div><strong><%= gerente.banco || '--' %></strong></div>
                        <small class="text-muted"><%= gerente.tipo_chave_pix ? gerente.tipo_chave_pix + ': ' : '' %><%= gerente.chave_pix || 'Sem PIX' %></small>
                    </div>
                </div>
            </div>

            <!-- Tabela de Vendedores Vinculados -->
            <h5 class="fw-bold text-secondary mb-3 fs-6 text-uppercase">Vendedores Associados (<%= vendedores.length %>)</h5>
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle bg-white mb-0 border">
                    <thead class="table-dark">
                        <tr>
                            <th class="py-3">ID</th>
                            <th class="py-3">Nome Resumido (Chave)</th>
                            <th class="py-3">Nome Completo</th>
                            <th class="py-3">Contacto</th>
                            <th class="py-3">PIX / Banco</th>
                            <th class="py-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (vendedores.length === 0) { %>
                            <tr><td colspan="6" class="text-center text-muted py-4">Nenhum vendedor vinculado a este gerente.</td></tr>
                        <% } else { %>
                            <% vendedores.forEach(v => { %>
                                <tr>
                                    <td class="fw-bold text-secondary">#<%= v.id %></td>
                                    <td><span class="badge text-white px-2 py-1" style="background-color: #20c997; font-size: 0.9rem;"><%= v.nome_resumido %></span></td>
                                    <td class="fw-bold text-dark"><%= v.nome_completo %></td>
                                    <td>
                                        <div><i class="fa-solid fa-phone text-muted me-1 small"></i> <%= v.telefone || '--' %></div>
                                        <div><i class="fa-solid fa-envelope text-muted me-1 small"></i> <%= v.email || '--' %></div>
                                    </td>
                                    <td>
                                        <div><strong><%= v.banco || '--' %></strong></div>
                                        <small class="text-muted"><%= v.tipo_chave_pix ? v.tipo_chave_pix + ': ' : '' %><%= v.chave_pix || 'Sem PIX' %></small>
                                    </td>
                                    <td>
                                        <% if (v.ativo === 1) { %>
                                            <span class="badge bg-success">Ativo</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Inativo</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>